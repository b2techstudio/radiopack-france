---
import BaseLayout from "../layouts/BaseLayout.astro";
import { defaultPublicPackId, publicPacks } from "../lib/packRegistry";

const defaultPack = publicPacks.find((pack) => pack.id === defaultPublicPackId) ?? publicPacks[0];
const defaultVariant = defaultPack.variants.find((variant) => variant.id === defaultPack.defaultVariant) ?? defaultPack.variants[0];
---
<BaseLayout
  title="Générateur de pack"
  description="Choisis un pack régional RadioPack France puis télécharge directement une variante CSV CHIRP RX-only validée."
>
  <section class="section generator-hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">Générateur web · multi-régions</span>
        <h1>Configure ton <span class="gradient-text">RadioPack</span></h1>
        <p class="lead">
          Choisis une région, ajuste les options disponibles pour ce pack, puis télécharge directement
          le CSV CHIRP RX-only correspondant à une variante publique déjà validée.
        </p>
        <div class="notice card">
          <strong>Une seule interface pour les packs publiés</strong>
          <p>
            Le générateur sélectionne uniquement des fichiers publics contrôlés par la CI.
            Il ne reconstruit pas de CSV indépendant dans ton navigateur.
          </p>
        </div>
      </div>

      <aside class="card status-card" aria-label="État du générateur">
        <span class="badge badge-green">2 packs publiés</span>
        <strong>Normandie + Annecy</strong>
        <p>Les packs proposés restent configurés en réception seule.</p>
        <dl>
          <div><dt>Duplex</dt><dd>off</dd></div>
          <div><dt>Téléchargement</dt><dd>direct</dd></div>
          <div><dt>CSV côté client</dt><dd>aucun</dd></div>
        </dl>
      </aside>
    </div>
  </section>

  <section class="section-tight">
    <div class="container generator-grid">
      <form class="card generator-form" id="radiopack-generator" novalidate>
        <div class="form-heading">
          <div>
            <span class="badge badge-green" id="pack-badge">{defaultPack.name} {defaultPack.version}</span>
            <h2>Options du pack</h2>
          </div>
          <span class="status-pill published" id="pack-status">{defaultPack.status}</span>
        </div>

        <fieldset>
          <legend>Région</legend>
          <label class="select-label" for="pack-select">Pack régional</label>
          <select id="pack-select" name="pack-select">
            {publicPacks.map((pack) => (
              <option value={pack.id} selected={pack.id === defaultPack.id}>
                {pack.name} · {pack.version}
              </option>
            ))}
          </select>
          <p class="muted" id="pack-description">{defaultPack.description}</p>
        </fieldset>

        <fieldset id="aviation-fieldset">
          <legend>Contenu</legend>
          <label class="option-row" for="include-aviation">
            <span>
              <strong>Inclure les fréquences aviation</strong>
              <small>Annecy : sélectionne la variante complète 65 mémoires ou la variante 48 sans aviation.</small>
            </span>
            <input id="include-aviation" name="include-aviation" type="checkbox" checked />
          </label>
        </fieldset>

        <fieldset id="notam-fieldset">
          <legend>Contrôle opérationnel facultatif</legend>
          <label class="option-row" for="notam-check">
            <span>
              <strong>Contrôle NOTAM avant génération</strong>
              <small>
                Disponible pour Annecy. Sert uniquement à suivre ta vérification et ne modifie jamais
                automatiquement les fréquences du CSV.
              </small>
            </span>
            <input id="notam-check" name="notam-check" type="checkbox" />
          </label>

          <div class="notam-confirm" id="notam-confirm-zone" hidden>
            <p>
              Les liens ci-dessous ouvrent les services officiels de consultation. Pour un pack
              d'écoute, cette vérification reste facultative et ne remplace pas les données de référence.
            </p>
            <div class="notam-links">
              <a href="https://sofia-briefing.aviation-civile.gouv.fr/sofia/pages/notamform.html" target="_blank" rel="noreferrer">SOFIA-Briefing · France ↗</a>
              <a href="https://www.skybriefing.com/fr/services/notam-briefing" target="_blank" rel="noreferrer">Skybriefing · Suisse ↗</a>
            </div>
            <div class="notam-confirm-check">
              <input id="notam-confirmed" name="notam-confirmed" type="checkbox" disabled />
              <label for="notam-confirmed">J'ai vérifié les NOTAM applicables</label>
            </div>
            <p class="muted">La confirmation reste facultative : le téléchargement est disponible même sans elle.</p>
          </div>
        </fieldset>

        <div class="form-actions">
          <a
            class="button button-primary"
            id="download-csv"
            href={defaultVariant.downloadUrl}
            download={defaultVariant.filename}
          >
            Télécharger le CSV · {defaultVariant.memoryCount} mémoires
          </a>
          <a class="button button-secondary" href="/telechargements">Tous les téléchargements</a>
        </div>
      </form>

      <aside class="card summary-card" aria-live="polite">
        <span class="eyebrow">Résumé</span>
        <div class="memory-counter">
          <strong id="memory-count">{defaultVariant.memoryCount}</strong>
          <span>mémoires</span>
        </div>

        <div class="summary-list">
          <div><span>Pack</span><strong id="pack-summary">{defaultPack.name} {defaultPack.version}</strong></div>
          <div><span>Aviation</span><strong id="aviation-summary">Incluse · 17</strong></div>
          <div><span>NOTAM</span><strong id="notam-summary">Non demandé</strong></div>
          <div><span>Mode</span><strong>Réception seule</strong></div>
          <div><span>Duplex</span><strong>off</strong></div>
          <div class="file-row"><span>Fichier</span><strong id="file-summary">{defaultVariant.filename}</strong></div>
        </div>

        <div class="summary-warning" id="notam-warning">
          Contrôle NOTAM non demandé. Les fréquences restent celles des sources officielles validées.
        </div>

        <p class="muted summary-note" id="variant-note">
          Pour Annecy, retirer l'aviation conserve les emplacements mémoire des autres blocs.
        </p>
      </aside>
    </div>
  </section>

  <section class="section-tight">
    <div class="container info-grid grid-3">
      <article class="card info-card">
        <span class="badge badge-green">Annecy · 65 / 48</span>
        <h3>Pack configurable</h3>
        <p>La variante aviation peut être incluse ou retirée sans modifier les autres blocs validés.</p>
      </article>
      <article class="card info-card">
        <span class="badge badge-green">Normandie · 142</span>
        <h3>Pack fixe publié</h3>
        <p>Le générateur propose directement le CSV Normandie v0.4 déjà validé.</p>
      </article>
      <article class="card info-card">
        <span class="badge badge-orange">Architecture</span>
        <h3>Prête pour la suite</h3>
        <p>Les futurs packs peuvent rejoindre le même registre sans recopier toute la page générateur.</p>
      </article>
    </div>
  </section>

  <script define:vars={{ publicPacks, defaultPublicPackId }}>
    const packSelect = document.querySelector("#pack-select");
    const packBadge = document.querySelector("#pack-badge");
    const packStatus = document.querySelector("#pack-status");
    const packDescription = document.querySelector("#pack-description");
    const aviationFieldset = document.querySelector("#aviation-fieldset");
    const aviation = document.querySelector("#include-aviation");
    const notamFieldset = document.querySelector("#notam-fieldset");
    const notam = document.querySelector("#notam-check");
    const confirmed = document.querySelector("#notam-confirmed");
    const confirmZone = document.querySelector("#notam-confirm-zone");
    const memoryCount = document.querySelector("#memory-count");
    const packSummary = document.querySelector("#pack-summary");
    const aviationSummary = document.querySelector("#aviation-summary");
    const notamSummary = document.querySelector("#notam-summary");
    const notamWarning = document.querySelector("#notam-warning");
    const fileSummary = document.querySelector("#file-summary");
    const variantNote = document.querySelector("#variant-note");
    const downloadLink = document.querySelector("#download-csv");

    const findPack = () => {
      const selectedId = packSelect?.value || defaultPublicPackId;
      return publicPacks.find((pack) => pack.id === selectedId) || publicPacks[0];
    };

    const findVariant = (pack) => {
      let variantId = pack.defaultVariant;
      if (pack.aviationToggle && aviation) {
        variantId = aviation.checked
          ? pack.aviationToggle.includedVariant
          : pack.aviationToggle.excludedVariant;
      }
      return pack.variants.find((variant) => variant.id === variantId) || pack.variants[0];
    };

    const resetUnsupportedControls = (pack) => {
      const aviationSupported = Boolean(pack.aviationToggle);
      if (aviationFieldset) aviationFieldset.hidden = !aviationSupported;
      if (aviation) aviation.disabled = !aviationSupported;

      if (notamFieldset) notamFieldset.hidden = !pack.notamCheck;
      if (notam) {
        notam.disabled = !pack.notamCheck;
        if (!pack.notamCheck) notam.checked = false;
      }
      if (confirmed && !pack.notamCheck) confirmed.checked = false;
    };

    const renderSummary = () => {
      const pack = findPack();
      if (!pack || !downloadLink || !memoryCount || !fileSummary || !packSummary || !aviationSummary || !notamSummary || !notamWarning || !confirmZone || !confirmed) return;

      resetUnsupportedControls(pack);
      const variant = findVariant(pack);
      if (!variant) return;

      if (packBadge) packBadge.textContent = `${pack.name} ${pack.version}`;
      if (packStatus) packStatus.textContent = pack.status;
      if (packDescription) packDescription.textContent = pack.description;
      packSummary.textContent = `${pack.name} ${pack.version}`;
      memoryCount.textContent = String(variant.memoryCount);
      fileSummary.textContent = variant.filename;
      downloadLink.href = variant.downloadUrl;
      downloadLink.setAttribute("download", variant.filename);
      downloadLink.textContent = `Télécharger le CSV · ${variant.memoryCount} mémoires`;

      if (pack.aviationToggle) {
        aviationSummary.textContent = variant.aviationIncluded ? `Incluse · ${pack.aviationToggle.memoryCount}` : "Exclue · 0";
        if (variantNote) variantNote.textContent = "Pour Annecy, retirer l'aviation conserve les emplacements mémoire des autres blocs.";
      } else {
        aviationSummary.textContent = "Configuration fixe";
        if (variantNote) variantNote.textContent = "Ce pack est proposé dans sa variante publique fixe déjà validée.";
      }

      const notamActive = Boolean(pack.notamCheck && notam?.checked);
      confirmZone.hidden = !notamActive;
      confirmed.disabled = !notamActive;

      if (!pack.notamCheck) {
        notamSummary.textContent = "Non proposé";
        notamWarning.textContent = "Ce pack utilise sa configuration publique fixe. Aucun contrôle NOTAM interactif n'est associé à cette variante.";
        return;
      }

      if (!notamActive) {
        notamSummary.textContent = "Non demandé";
        notamWarning.textContent = "Contrôle NOTAM non demandé. Les fréquences restent celles des sources officielles validées.";
        return;
      }

      if (confirmed.checked) {
        notamSummary.textContent = "Confirmé";
        notamWarning.textContent = "Contrôle NOTAM confirmé. Le fichier téléchargé reste la variante publique validée, sans modification automatique des fréquences.";
      } else {
        notamSummary.textContent = "Demandé · non confirmé";
        notamWarning.textContent = "Contrôle NOTAM demandé mais non confirmé. Cette vérification reste facultative et non bloquante.";
      }
    };

    packSelect?.addEventListener("change", renderSummary);
    aviation?.addEventListener("change", renderSummary);
    notam?.addEventListener("change", () => {
      if (confirmed && notam && !notam.checked) confirmed.checked = false;
      renderSummary();
    });
    confirmed?.addEventListener("change", renderSummary);
    renderSummary();
  </script>
</BaseLayout>

<style>
  .generator-hero { padding-bottom: 48px; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(280px, .55fr); gap: 28px; align-items: end; }
  .hero-copy { display: grid; gap: 24px; }
  .hero-copy h1 { max-width: 850px; }
  .notice { display: grid; gap: 6px; max-width: 760px; padding: 18px 20px; border-left: 4px solid var(--green); }
  .notice p, .status-card > p { color: var(--muted); }
  .status-card { display: grid; gap: 13px; padding: 24px; }
  .status-card > strong { font-family: "Space Grotesk", sans-serif; font-size: 2rem; }
  .status-card dl { display: grid; gap: 9px; margin: 4px 0 0; }
  .status-card dl div { display: flex; justify-content: space-between; gap: 20px; padding-top: 9px; border-top: 1px solid var(--line); }
  .status-card dt { color: var(--muted); }
  .status-card dd { margin: 0; font-weight: 800; }
  .generator-grid { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(300px, .65fr); gap: 22px; align-items: start; }
  .generator-form, .summary-card { padding: 28px; }
  .generator-form { display: grid; gap: 24px; }
  .form-heading { display: flex; align-items: start; justify-content: space-between; gap: 16px; }
  .form-heading > div { display: grid; gap: 10px; }
  .form-heading h2 { font-size: clamp(1.8rem, 4vw, 2.6rem); }
  .status-pill { padding: .4rem .65rem; border-radius: 999px; font-size: .75rem; font-weight: 850; white-space: nowrap; }
  .status-pill.published { background: rgba(16,164,122,.13); color: #087154; }
  fieldset { display: grid; gap: 12px; margin: 0; padding: 0; border: 0; }
  fieldset[hidden] { display: none; }
  legend { margin-bottom: 8px; font-size: .78rem; font-weight: 850; color: var(--muted); text-transform: uppercase; letter-spacing: .08em; }
  .select-label { font-weight: 800; }
  select { width: 100%; padding: .85rem 1rem; border: 1px solid var(--line); border-radius: 13px; background: #fff; color: inherit; font: inherit; }
  .option-row { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 18px; border: 1px solid var(--line); border-radius: 16px; background: rgba(248,250,252,.78); cursor: pointer; }
  .option-row > span { display: grid; gap: 4px; }
  .option-row small { color: var(--muted); font-size: .88rem; }
  .option-row input { width: 22px; height: 22px; accent-color: var(--purple); flex: 0 0 auto; }
  .notam-confirm { display: grid; gap: 12px; margin-top: 2px; padding: 18px; border-radius: 16px; background: rgba(22,135,233,.07); border: 1px solid rgba(22,135,233,.14); }
  .notam-confirm[hidden] { display: none; }
  .notam-links { display: flex; flex-wrap: wrap; gap: 10px; }
  .notam-links a { padding: .55rem .7rem; border-radius: 10px; background: rgba(255,255,255,.8); border: 1px solid var(--line); font-size: .82rem; font-weight: 800; }
  .notam-confirm-check { display: flex; gap: 10px; align-items: center; }
  .notam-confirm-check label { font-weight: 800; cursor: pointer; }
  .notam-confirm-check input { width: 19px; height: 19px; accent-color: var(--purple); cursor: pointer; }
  .notam-confirm-check input:disabled { cursor: not-allowed; }
  .form-actions { display: flex; flex-wrap: wrap; gap: 12px; padding-top: 4px; }
  .summary-card { position: sticky; top: 110px; display: grid; gap: 20px; }
  .memory-counter { display: flex; align-items: baseline; gap: 10px; }
  .memory-counter strong { font-family: "Space Grotesk", sans-serif; font-size: clamp(4rem, 8vw, 6rem); line-height: .9; letter-spacing: -.06em; }
  .memory-counter span { color: var(--muted); font-weight: 800; }
  .summary-list { display: grid; }
  .summary-list div { display: flex; justify-content: space-between; gap: 18px; padding: 11px 0; border-top: 1px solid var(--line); }
  .summary-list span { color: var(--muted); }
  .summary-list strong { text-align: right; }
  .summary-list .file-row { align-items: flex-start; }
  .file-row strong { max-width: 220px; overflow-wrap: anywhere; font-size: .78rem; }
  .summary-warning { padding: 14px; border-radius: 13px; background: rgba(240,154,32,.11); color: #6e460d; font-size: .9rem; }
  .summary-note { font-size: .88rem; }
  .info-grid { padding-bottom: 34px; }
  .info-card { display: grid; gap: 12px; padding: 22px; }
  .info-card p { color: var(--muted); }
  @media (max-width: 900px) { .hero-grid, .generator-grid { grid-template-columns: 1fr; } .summary-card { position: static; } }
  @media (max-width: 600px) { .generator-form, .summary-card { padding: 20px; } .form-heading { flex-direction: column; } .option-row { align-items: flex-start; } .option-row input { margin-top: 2px; } }
</style>
