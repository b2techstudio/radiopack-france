---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="À propos — RadioPack France">
  <section class="section"><div class="container about"><img src="/brand/b2tech-logo.png" alt="B2Tech Studio"/><div><span class="eyebrow">B2Tech Studio</span><h1>Un projet utile,<br/><span class="gradient-text">pas une liste jetable.</span></h1><p class="lead">RadioPack France vise à fournir des données radio régionales claires, maintenables et documentées, avec un site accessible et une architecture évolutive.</p><a class="button button-primary" href="https://github.com/b2techstudio/radiopack-france">Voir le dépôt GitHub</a></div></div></section>
</BaseLayout>
<style>.about{display:grid;grid-template-columns:.65fr 1.35fr;gap:60px;align-items:center}.about img{width:min(100%,420px);border-radius:28px;box-shadow:var(--shadow)}.about>div{display:grid;gap:22px}.about h1{font-size:clamp(3rem,7vw,5.4rem)}@media(max-width:800px){.about{grid-template-columns:1fr}.about img{max-width:260px}}</style>
