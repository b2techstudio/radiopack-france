---
import LightDesignLabLayout from "../../../layouts/LightDesignLabLayout.astro";
import { publicPacks } from "../../../lib/packRegistry";
const order = ["normandie", "annecy-alpes-leman", "bretagne"];
const packs = order.map((id) => publicPacks.find((pack) => pack.id === id)).filter(Boolean).map((pack: any) => ({ ...pack, count: pack.variants.find((v: any) => v.id === pack.defaultVariant)?.memoryCount ?? pack.variants[0]?.memoryCount ?? 0 }));
---
<LightDesignLabLayout title="Polar Neon" description="Concept clair Polar Neon pour RadioPack France." concept="polar-neon" themeColor="#f7fbff">
  <div class="polar">
    <section class="hero wrap"><div class="micro">RADIOPACK FRANCE <span>×</span> B2TECH STUDIO</div><h1>Le signal,<br /><em>en pleine lumière.</em></h1><div class="hero-foot"><p>Des codeplugs CHIRP régionaux, versionnés, sourcés et distribués en réception seule.</p><div><a href="/regions">Explorer les packs <b>↗</b></a><a class="text" href="/generateur">Générateur</a></div></div><div class="beam"></div></section>
    <section class="packs wrap"><div class="label">PACKS DISPONIBLES</div>{packs.map((pack:any,i)=><a class="row" href={`/regions/${pack.regionSlug}`}><span class="num">0{i+1}</span><div><small>{pack.version} · PUBLIC RX</small><h2>{pack.name}</h2></div><div class="count"><strong>{pack.count}</strong><span>mémoires</span></div><i>→</i></a>)}</section>
    <section class="statement wrap"><small>PHILOSOPHIE</small><h2>Technique dans le fond.<br /><em>Évident dans la forme.</em></h2><p>Polar Neon conserve l’ADN bleu/violet de B2Tech, mais le pose sur une interface blanche et glacée. Les effets lumineux deviennent des repères, pas un décor permanent.</p></section>
    <section class="chips wrap"><span>PUBLIC</span><span>RX ONLY</span><span>VERSIONNÉ</span><span>SOURCÉ</span></section>
  </div>
</LightDesignLabLayout>
<style>
  .polar{min-height:100vh;background:#f7fbff;color:#111827;overflow:hidden}.wrap{width:min(1180px,calc(100% - 36px));margin:auto}.hero{position:relative;padding:100px 0 86px}.micro{font-size:.72rem;font-weight:950;letter-spacing:.2em;color:#516072}.micro span{color:#00aeef;margin:0 8px}.hero h1{position:relative;z-index:2;margin:26px 0 42px;max-width:1100px;font-size:clamp(4.2rem,10vw,9.2rem);line-height:.88;letter-spacing:-.075em}.hero h1 em{font-style:normal;color:transparent;background:linear-gradient(90deg,#00aeef,#8b5cf6);background-clip:text;-webkit-background-clip:text}.hero-foot{position:relative;z-index:2;display:flex;justify-content:space-between;gap:50px;align-items:end}.hero-foot p{max-width:580px;color:#637188;font-size:1.08rem;line-height:1.65}.hero-foot>div{display:flex;gap:12px;align-items:center}.hero-foot a{padding:14px 18px;border-radius:999px;background:#111827;color:white;font-size:.78rem;font-weight:900}.hero-foot a b{color:#67e8f9;margin-left:10px}.hero-foot a.text{background:transparent;color:#48576c;border:1px solid #cfd9e7}.beam{position:absolute;width:560px;height:560px;right:-170px;top:-170px;border-radius:50%;background:radial-gradient(circle,rgba(0,174,239,.17),rgba(139,92,246,.08) 45%,transparent 68%);filter:blur(5px)}.packs{padding:18px 0 78px}.label{padding-bottom:14px;border-bottom:1px solid #bccbdd;color:#64748b;font-size:.68rem;font-weight:900;letter-spacing:.18em}.row{display:grid;grid-template-columns:70px 1fr 130px 42px;gap:24px;align-items:center;min-height:144px;border-bottom:1px solid #d6e0eb;transition:padding .18s ease,background .18s ease}.row:hover{padding-inline:14px;background:linear-gradient(90deg,rgba(0,174,239,.045),rgba(139,92,246,.035))}.num{color:#00aeef;font-weight:950}.row small{color:#7d8ba0;font-size:.68rem;font-weight:850;letter-spacing:.08em}.row h2{margin:9px 0 0;font-size:clamp(2rem,4.5vw,4rem);letter-spacing:-.055em}.count{display:grid;text-align:right}.count strong{font-size:2.35rem;line-height:1;color:#8b5cf6}.count span{margin-top:5px;color:#8290a3;font-size:.7rem}.row i{font-style:normal;font-size:1.4rem;color:#00aeef}.statement{display:grid;grid-template-columns:160px 1.25fr .8fr;gap:35px;padding:74px 0}.statement small{color:#8b5cf6;font-size:.68rem;font-weight:950;letter-spacing:.18em}.statement h2{margin:0;font-size:clamp(2.7rem,5.8vw,5.2rem);line-height:.98;letter-spacing:-.055em}.statement h2 em{font-style:normal;color:#00aeef}.statement p{margin:0;color:#6c7a8e;line-height:1.75}.chips{display:flex;gap:10px;flex-wrap:wrap;padding:0 0 100px}.chips span{padding:9px 12px;border:1px solid #d3ddea;border-radius:999px;background:white;color:#536176;font-size:.68rem;font-weight:900;letter-spacing:.1em;box-shadow:0 6px 18px rgba(51,72,103,.05)}@media(max-width:800px){.hero-foot,.statement{display:grid;grid-template-columns:1fr}.hero-foot>div{flex-wrap:wrap}.row{grid-template-columns:44px 1fr 75px}.row i{display:none}.count strong{font-size:1.7rem}}
</style>
