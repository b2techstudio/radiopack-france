---
import BaseLayout from "../layouts/BaseLayout.astro";
import { publicPacks } from "../lib/packRegistry";

const preferredOrder = ["normandie", "annecy-alpes-leman", "bretagne"];
const packs = preferredOrder
  .map((id) => publicPacks.find((pack) => pack.id === id))
  .filter((pack): pack is (typeof publicPacks)[number] => Boolean(pack))
  .map((pack) => ({
    ...pack,
    count:
      pack.variants.find((variant) => variant.id === pack.defaultVariant)?.memoryCount ??
      pack.variants[0]?.memoryCount ??
      0,
  }));
const totalMemories = packs.reduce((sum, pack) => sum + pack.count, 0);
---

<BaseLayout
  title="RadioPack France — Codeplugs CHIRP régionaux"
  description="Des codeplugs CHIRP régionaux, publics, vérifiés et distribués en réception seule pour les radios Quansheng UV-K5."
  themeColor="#182538"
  colorScheme="dark"
  bodyClass="home-midnight-blue"
>
  <div class="midnight-page">
    <section class="hero wrap">
      <div class="hero-copy">
        <span class="eyebrow">RADIOPACK FRANCE · B2TECH STUDIO</span>
        <h1>La radio,<br /><em>organisée.</em><br />Région par région.</h1>
        <p>
          Des packs CHIRP publics, vérifiés et versionnés pour Quansheng UV-K5.
          Les informations utiles restent lisibles, les versions publiques restent immuables,
          et les fichiers distribués sont en réception seule.
        </p>
        <div class="actions">
          <a class="primary" href="/regions">Choisir un pack</a>
          <a href="/generateur">Ouvrir le générateur</a>
        </div>
        <div class="status-line">
          <span><i></i> {packs.length} packs publics</span>
          <span>{totalMemories} mémoires RX</span>
        </div>
      </div>

      <div class="radio-orbit" aria-label="Visualisation radio moderne RadioPack France">
        <div class="ambient-grid" aria-hidden="true"></div>
        <div class="signal-ring ring-one" aria-hidden="true"></div>
        <div class="signal-ring ring-two" aria-hidden="true"></div>

        <div class="modern-console">
          <div class="console-head">
            <div class="console-brand">
              <span class="brand-dot"></span>
              <div><small>RADIOPACK</small><strong>RX DASHBOARD</strong></div>
            </div>
            <span class="rx-pill"><i></i> RX ONLY</span>
          </div>

          <div class="console-main">
            <div class="tuner-zone">
              <div class="tuner-shell">
                <div class="tuner-ring">
                  <span class="orbit-point" aria-hidden="true"></span>
                  <div class="tuner-core">
                    <small>VFO A · 2 M</small>
                    <strong>145.500</strong>
                    <span>MHz</span>
                  </div>
                </div>
              </div>
              <div class="tuner-meta">
                <span>FM</span><i></i><span>12.5 kHz</span><i></i><span>SQL 03</span>
              </div>
            </div>

            <div class="quick-stats">
              <div class="stat-card secondary-vfo">
                <small>VFO B · 70 CM</small>
                <strong>433.500</strong>
                <span>FM · 12.5 kHz</span>
              </div>
              <div class="stat-card memory-card">
                <small>MEMORY BANK</small>
                <strong>{totalMemories}</strong>
                <span>{packs.length} packs publics</span>
              </div>
              <div class="stat-card mode-card">
                <small>MODE</small>
                <strong>CHIRP</strong>
                <span>Quansheng UV-K5</span>
              </div>
            </div>
          </div>

          <div class="spectrum-card" aria-hidden="true">
            <div class="spectrum-head"><span>RX SPECTRUM</span><b>LIVE VIEW</b></div>
            <div class="spectrum-bars">
              {Array.from({ length: 40 }).map((_, i) => (
                <i style={`--bar:${18 + ((i * 37) % 76)}%;--delay:${(i % 8) * -0.12}s`}></i>
              ))}
            </div>
            <div class="spectrum-line"></div>
          </div>

          <div class="console-foot">
            <span><i></i> Réception seule</span>
            <span>PUBLIC DATA</span>
            <span>VERSIONED</span>
          </div>
        </div>

        <div class="float-chip chip-left"><i></i> SIGNAL READY</div>
        <div class="float-chip chip-right">{totalMemories} MEM</div>
      </div>
    </section>

    <section class="band-strip wrap" aria-label="Repères radioamateur">
      <div><small>BAND</small><b>6 m</b><span>50 MHz</span></div>
      <div><small>BAND</small><b>2 m</b><span>144–146</span></div>
      <div><small>BAND</small><b>70 cm</b><span>430–440</span></div>
      <div class="status"><small>PUBLIC PACKS</small><b>{packs.length}</b><span>{totalMemories} mémoires RX</span></div>
    </section>

    <section class="packs wrap" aria-labelledby="packs-title">
      <div class="section-head">
        <span>MEMORY BANKS</span>
        <h2 id="packs-title">Les régions deviennent<br /><em>des banques mémoire.</em></h2>
        <p>Choisis ton territoire, consulte la version publique disponible et ouvre directement le pack régional correspondant.</p>
      </div>

      <div class="pack-list">
        {packs.map((pack, index) => (
          <a class="pack" href={`/regions/${pack.regionSlug}`}>
            <span class="bank">B{String(index + 1).padStart(2, "0")}</span>
            <div class="pack-name"><small>{pack.version} · PUBLIC RX</small><h3>{pack.name}</h3></div>
            <strong>{pack.count}<small>MEM</small></strong>
            <i aria-hidden="true">→</i>
          </a>
        ))}
      </div>
    </section>

    <section class="principles wrap" aria-label="Principes RadioPack France">
      <article><span>01</span><h3>Sources vérifiables</h3><p>Les données intégrées aux packs proviennent de sources publiques documentées.</p></article>
      <article><span>02</span><h3>Réception seule</h3><p>Les packs publics sont distribués avec la transmission désactivée.</p></article>
      <article><span>03</span><h3>Versions immuables</h3><p>Une version publiée reste identifiable et reproductible dans le temps.</p></article>
    </section>

    <section class="cta wrap">
      <div>
        <small>RADIOPACK / GENERATOR</small>
        <h2>Compose ton pack.<br />Garde seulement l’utile.</h2>
      </div>
      <a href="/generateur">Ouvrir le générateur <span>→</span></a>
    </section>
  </div>
</BaseLayout>

<style>
  .midnight-page {
    --bg: #182538;
    --surface: #223249;
    --card: #2b3d56;
    --text: #f4f7fb;
    --muted: #adbed1;
    --accent: #4ea8ff;
    --accent2: #9185ff;
    --rx: #65d7b1;
    --signal: #f4c95d;
    min-height: 100vh;
    overflow: hidden;
    background:
      radial-gradient(circle at 78% 4%, rgba(145, 133, 255, .13), transparent 32rem),
      radial-gradient(circle at 10% 31%, rgba(78, 168, 255, .10), transparent 28rem),
      var(--bg);
    color: var(--text);
  }

  .wrap { width: min(1180px, calc(100% - 36px)); margin-inline: auto; }

  .hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(38px, 6vw, 88px);
    align-items: center;
    min-height: 720px;
    padding-block: 76px;
  }

  .eyebrow,
  .section-head > span {
    color: var(--accent);
    font-size: .71rem;
    font-weight: 950;
    letter-spacing: .19em;
  }

  .hero h1 {
    margin: 19px 0 24px;
    font-size: clamp(4rem, 7.6vw, 7.4rem);
    line-height: .87;
    letter-spacing: -.07em;
  }

  .hero h1 em,
  .section-head h2 em { color: var(--accent2); font-style: normal; }

  .hero-copy > p {
    max-width: 620px;
    color: var(--muted);
    font-size: 1.08rem;
    line-height: 1.72;
  }

  .actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 30px; }
  .actions a { padding: 13px 17px; border: 1px solid rgba(244,247,251,.22); border-radius: 10px; font-size: .83rem; font-weight: 850; transition: transform .18s ease, background .18s ease, border-color .18s ease; }
  .actions a:hover { transform: translateY(-2px); border-color: rgba(244,247,251,.42); }
  .actions .primary { color: var(--bg); background: var(--text); border-color: var(--text); }

  .status-line { display: flex; flex-wrap: wrap; gap: 20px; margin-top: 31px; color: #8198b2; font-size: .72rem; font-weight: 800; letter-spacing: .04em; }
  .status-line span { display: flex; align-items: center; gap: 7px; }
  .status-line i { width: 7px; height: 7px; border-radius: 50%; background: var(--rx); box-shadow: 0 0 14px rgba(101,215,177,.45); }

  /* Hero visual — modern radio dashboard, intentionally different from a classic transceiver screen. */
  .radio-orbit {
    position: relative;
    min-height: 560px;
    display: grid;
    place-items: center;
    perspective: 1200px;
  }

  .ambient-grid {
    position: absolute;
    inset: 5% -4% 2%;
    border-radius: 42px;
    opacity: .42;
    background:
      linear-gradient(rgba(133,161,193,.055) 1px, transparent 1px),
      linear-gradient(90deg, rgba(133,161,193,.055) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: radial-gradient(ellipse at center, #000 26%, transparent 75%);
  }

  .signal-ring {
    position: absolute;
    border: 1px solid rgba(113,178,255,.11);
    border-radius: 50%;
    pointer-events: none;
  }

  .ring-one { width: 470px; height: 470px; }
  .ring-two { width: 555px; height: 555px; border-color: rgba(145,133,255,.085); }

  .modern-console {
    position: relative;
    z-index: 2;
    width: min(100%, 570px);
    padding: 15px;
    overflow: hidden;
    border: 1px solid rgba(186,210,237,.13);
    border-radius: 30px;
    background:
      radial-gradient(circle at 12% 3%, rgba(101,215,177,.09), transparent 28%),
      radial-gradient(circle at 92% 10%, rgba(145,133,255,.15), transparent 32%),
      linear-gradient(145deg, rgba(36,53,76,.92), rgba(18,31,49,.96));
    box-shadow:
      0 38px 95px rgba(4,10,20,.38),
      0 0 90px rgba(78,168,255,.055),
      inset 0 1px 0 rgba(255,255,255,.07);
    backdrop-filter: blur(24px) saturate(1.12);
    transform: rotateY(-3deg) rotateX(1deg);
    transition: transform .45s cubic-bezier(.2,.75,.2,1), box-shadow .45s ease;
  }

  .modern-console::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(118deg, transparent 24%, rgba(255,255,255,.045) 43%, transparent 57%);
    transform: translateX(-80%);
  }

  .console-head,
  .console-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .console-head { padding: 4px 5px 15px; }

  .console-brand { display: flex; align-items: center; gap: 10px; }
  .brand-dot { width: 10px; height: 10px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 5px rgba(78,168,255,.075), 0 0 22px rgba(78,168,255,.35); }
  .console-brand div { display: grid; gap: 1px; }
  .console-brand small { color: #6f8aa8; font: 800 .56rem "SFMono-Regular", Consolas, monospace; letter-spacing: .18em; }
  .console-brand strong { color: #d8e5f3; font: 900 .68rem "SFMono-Regular", Consolas, monospace; letter-spacing: .12em; }

  .rx-pill {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 10px;
    border: 1px solid rgba(101,215,177,.16);
    border-radius: 999px;
    background: rgba(101,215,177,.06);
    color: #8ce8c9;
    font: 900 .59rem "SFMono-Regular", Consolas, monospace;
    letter-spacing: .08em;
  }
  .rx-pill i { width: 6px; height: 6px; border-radius: 50%; background: var(--rx); box-shadow: 0 0 12px rgba(101,215,177,.65); }

  .console-main {
    display: grid;
    grid-template-columns: 1.25fr .9fr;
    gap: 12px;
  }

  .tuner-zone,
  .stat-card,
  .spectrum-card {
    border: 1px solid rgba(185,207,232,.085);
    background: rgba(12,24,40,.46);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.025);
  }

  .tuner-zone {
    min-height: 300px;
    display: grid;
    place-items: center;
    align-content: center;
    padding: 22px 16px 15px;
    border-radius: 22px;
    background:
      radial-gradient(circle at 50% 44%, rgba(78,168,255,.11), transparent 43%),
      rgba(12,24,40,.48);
  }

  .tuner-shell {
    position: relative;
    width: min(238px, 88%);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
  }

  .tuner-shell::before,
  .tuner-shell::after {
    content: "";
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }

  .tuner-shell::before {
    inset: -13px;
    border: 1px solid rgba(78,168,255,.10);
    box-shadow: 0 0 50px rgba(78,168,255,.05);
  }

  .tuner-shell::after {
    inset: 18px;
    border: 1px dashed rgba(146,170,198,.12);
  }

  .tuner-ring {
    position: relative;
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background:
      radial-gradient(circle at center, #15263b 0 55%, transparent 56%),
      conic-gradient(from 205deg, rgba(78,168,255,.15), #4ea8ff 18%, #9185ff 46%, rgba(101,215,177,.92) 68%, rgba(101,215,177,.08) 84%, rgba(78,168,255,.15));
    box-shadow: 0 0 55px rgba(78,168,255,.11), inset 0 0 35px rgba(145,133,255,.08);
  }

  .tuner-ring::before {
    content: "";
    position: absolute;
    inset: 5px;
    border: 1px solid rgba(255,255,255,.09);
    border-radius: 50%;
  }

  .orbit-point {
    position: absolute;
    top: 8px;
    left: 50%;
    width: 9px;
    height: 9px;
    margin-left: -4.5px;
    border-radius: 50%;
    background: #d9f7ec;
    box-shadow: 0 0 0 5px rgba(101,215,177,.10), 0 0 19px rgba(101,215,177,.8);
    transform-origin: 4.5px 111px;
  }

  .tuner-core {
    position: relative;
    z-index: 2;
    width: 68%;
    aspect-ratio: 1;
    display: grid;
    place-content: center;
    text-align: center;
    border: 1px solid rgba(185,210,237,.08);
    border-radius: 50%;
    background: radial-gradient(circle at 50% 32%, rgba(45,68,94,.86), rgba(13,27,44,.98) 68%);
    box-shadow: inset 0 0 35px rgba(78,168,255,.06), 0 14px 32px rgba(4,10,20,.25);
  }

  .tuner-core small { color: #8098b3; font: 850 .58rem "SFMono-Regular", Consolas, monospace; letter-spacing: .13em; }
  .tuner-core strong { margin-top: 5px; color: #f4f8fd; font: 800 clamp(2rem, 4vw, 2.85rem) "SFMono-Regular", Consolas, monospace; letter-spacing: -.075em; text-shadow: 0 0 28px rgba(78,168,255,.12); }
  .tuner-core span { margin-top: -1px; color: #78e1bd; font: 850 .64rem "SFMono-Regular", Consolas, monospace; letter-spacing: .17em; }

  .tuner-meta { display: flex; align-items: center; justify-content: center; gap: 7px; margin-top: 17px; color: #7890aa; font: 800 .57rem "SFMono-Regular", Consolas, monospace; letter-spacing: .07em; }
  .tuner-meta i { width: 3px; height: 3px; border-radius: 50%; background: #4b6684; }

  .quick-stats { display: grid; grid-template-rows: 1.25fr 1fr 1fr; gap: 12px; }
  .stat-card { display: grid; align-content: center; padding: 16px; border-radius: 19px; overflow: hidden; position: relative; }
  .stat-card::after { content: ""; position: absolute; right: -34px; top: -36px; width: 90px; height: 90px; border-radius: 50%; background: rgba(78,168,255,.075); filter: blur(2px); }
  .memory-card::after { background: rgba(145,133,255,.09); }
  .mode-card::after { background: rgba(101,215,177,.075); }
  .stat-card small { position: relative; z-index: 1; color: #718aa6; font: 850 .55rem "SFMono-Regular", Consolas, monospace; letter-spacing: .12em; }
  .stat-card strong { position: relative; z-index: 1; margin: 5px 0 2px; color: #edf4fb; font: 850 1.62rem "SFMono-Regular", Consolas, monospace; letter-spacing: -.055em; }
  .secondary-vfo strong { color: #9ec9ff; }
  .memory-card strong { color: #b0a7ff; }
  .mode-card strong { color: #86e5c5; font-size: 1.32rem; letter-spacing: -.025em; }
  .stat-card span { position: relative; z-index: 1; color: #8298b0; font-size: .63rem; font-weight: 750; }

  .spectrum-card {
    position: relative;
    height: 140px;
    margin-top: 12px;
    padding: 13px 14px 11px;
    overflow: hidden;
    border-radius: 20px;
    background:
      linear-gradient(rgba(133,160,191,.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(133,160,191,.04) 1px, transparent 1px),
      rgba(10,22,38,.55);
    background-size: 100% 25%, 10% 100%, auto;
  }

  .spectrum-head { position: relative; z-index: 3; display: flex; justify-content: space-between; align-items: center; color: #6f88a4; font: 850 .53rem "SFMono-Regular", Consolas, monospace; letter-spacing: .13em; }
  .spectrum-head b { color: #78dfbd; font-size: .52rem; }
  .spectrum-bars { position: absolute; z-index: 1; left: 14px; right: 14px; bottom: 13px; height: 86px; display: flex; align-items: end; gap: 3px; }
  .spectrum-bars i { flex: 1; min-width: 2px; height: var(--bar); border-radius: 999px 999px 2px 2px; background: linear-gradient(180deg, #69bcff 0%, #7d9cff 50%, #a184ff 100%); opacity: .78; transform-origin: bottom; }
  .spectrum-line { position: absolute; z-index: 2; left: -22%; top: 31px; width: 18%; height: 96px; background: linear-gradient(90deg, transparent, rgba(101,215,177,.20), rgba(78,168,255,.12), transparent); filter: blur(2px); transform: skewX(-10deg); }

  .console-foot {
    margin-top: 12px;
    padding: 10px 6px 2px;
    color: #647e9a;
    font: 800 .52rem "SFMono-Regular", Consolas, monospace;
    letter-spacing: .1em;
  }
  .console-foot span:first-child { display: inline-flex; align-items: center; gap: 6px; color: #88a0b9; }
  .console-foot i { width: 5px; height: 5px; border-radius: 50%; background: var(--rx); box-shadow: 0 0 10px rgba(101,215,177,.55); }

  .float-chip {
    position: absolute;
    z-index: 4;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 9px 11px;
    border: 1px solid rgba(186,209,235,.12);
    border-radius: 999px;
    background: rgba(24,39,59,.86);
    color: #91aac5;
    box-shadow: 0 12px 32px rgba(4,10,20,.23);
    backdrop-filter: blur(14px);
    font: 850 .55rem "SFMono-Regular", Consolas, monospace;
    letter-spacing: .09em;
  }
  .float-chip i { width: 6px; height: 6px; border-radius: 50%; background: var(--rx); box-shadow: 0 0 10px rgba(101,215,177,.5); }
  .chip-left { left: -7px; top: 29%; }
  .chip-right { right: -12px; bottom: 17%; color: #c0b9ff; }

  .band-strip { display: grid; grid-template-columns: repeat(4, 1fr); border-block: 1px solid rgba(244,247,251,.14); }
  .band-strip > div { padding: 25px 22px; border-right: 1px solid rgba(244,247,251,.14); }
  .band-strip > div:last-child { border-right: 0; }
  .band-strip small { display: block; color: #96aac1; font: 850 .64rem "SFMono-Regular", Consolas, monospace; letter-spacing: .1em; }
  .band-strip b { display: block; margin: 14px 0 4px; font-size: 2rem; letter-spacing: -.05em; }
  .band-strip span { color: #9eb2c9; font-size: .8rem; }
  .band-strip .status b { color: var(--rx); }

  .packs { padding-block: 108px 92px; }
  .section-head { display: grid; grid-template-columns: 1fr .7fr; gap: 30px; align-items: end; margin-bottom: 38px; }
  .section-head > span { grid-column: 1 / -1; }
  .section-head h2 { margin: 0; font-size: clamp(2.7rem, 5.4vw, 5.2rem); line-height: .94; letter-spacing: -.06em; }
  .section-head p { margin: 0; color: var(--muted); line-height: 1.7; }

  .pack-list { border-top: 1px solid rgba(244,247,251,.14); }
  .pack { display: grid; grid-template-columns: 72px 1fr 110px 28px; gap: 18px; align-items: center; padding: 25px 10px; border-bottom: 1px solid rgba(244,247,251,.14); transition: background .18s ease, padding .18s ease; }
  .pack:hover { padding-inline: 18px; background: var(--surface); }
  .bank { color: var(--accent); font: 900 1rem "SFMono-Regular", Consolas, monospace; }
  .pack small { color: #9eb1c7; font: 800 .64rem "SFMono-Regular", Consolas, monospace; letter-spacing: .08em; }
  .pack h3 { margin: 5px 0 0; font-size: clamp(1.35rem, 3vw, 2.15rem); letter-spacing: -.04em; }
  .pack > strong { color: var(--text); font-size: 2rem; }
  .pack > strong small { margin-left: 5px; }
  .pack > i { color: var(--signal); font-size: 1.45rem; font-style: normal; }

  .principles { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; padding-bottom: 110px; }
  .principles article { min-height: 230px; padding: 25px; border: 1px solid rgba(244,247,251,.12); border-radius: 16px; background: var(--card); }
  .principles article > span { color: var(--accent2); font: 900 .7rem "SFMono-Regular", Consolas, monospace; }
  .principles h3 { margin: 48px 0 10px; font-size: 1.35rem; }
  .principles p { margin: 0; color: var(--muted); line-height: 1.65; }

  .cta { display: flex; align-items: end; justify-content: space-between; gap: 40px; margin-bottom: 80px; padding: 42px; border: 1px solid rgba(244,247,251,.13); border-radius: 22px; background: linear-gradient(120deg, #223249, #1d2c41); box-shadow: inset 0 0 70px rgba(78,168,255,.035); }
  .cta small { color: var(--rx); font-size: .62rem; font-weight: 900; letter-spacing: .17em; }
  .cta h2 { margin-top: 17px; font-size: clamp(2.1rem, 4.5vw, 4rem); line-height: .95; letter-spacing: -.055em; }
  .cta > a { flex: 0 0 auto; padding: 14px 18px; border-radius: 10px; color: #182538; background: var(--signal); font-size: .76rem; font-weight: 900; }
  .cta > a span { margin-left: 22px; }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
