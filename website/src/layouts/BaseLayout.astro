---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  themeColor?: string;
  colorScheme?: "light" | "dark";
  bodyClass?: string;
}

const {
  title = "RadioPack France — Codeplugs CHIRP régionaux",
  description = "Codeplugs CHIRP organisés et documentés pour les radios Quansheng UV-K5 en France.",
  image = "/brand/b2tech-logo.png",
  noindex = false,
  themeColor = "#eef3f8",
  colorScheme = "light",
  bodyClass,
} = Astro.props;

const siteURL = Astro.site ?? new URL("https://radiopack.b2tech.studio");
const canonicalURL = new URL(Astro.url.pathname, siteURL);
const socialImageURL = new URL(image, siteURL);
const resolvedTitle = title.includes("RadioPack France")
  ? title
  : `${title} — RadioPack France`;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "RadioPack France",
  url: siteURL.href,
  description,
  inLanguage: "fr-FR",
  publisher: {
    "@type": "Organization",
    name: "B2Tech Studio",
    url: "https://github.com/b2techstudio",
  },
};
const structuredDataJSON = JSON.stringify(structuredData).replace(/</g, "\\u003c");
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
    <meta name="theme-color" content={themeColor} />
    <meta name="color-scheme" content={colorScheme} />

    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/brand/b2tech-logo.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="RadioPack France" />
    <meta property="og:title" content={resolvedTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:alt" content="Logo RadioPack France par B2Tech Studio" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={resolvedTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />

    <title>{resolvedTitle}</title>
    <script type="application/ld+json" set:html={structuredDataJSON} />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <Header />
    <main id="contenu"><slot /></main>
    <Footer />

    <script>
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (!reducedMotion) {
        document.documentElement.classList.add("motion-enabled");

        const revealTargets = document.querySelectorAll<HTMLElement>(
          "main section, main .region-card, main .download-card, main .pack-card"
        );

        const revealObserver = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add("motion-visible");
              revealObserver.unobserve(entry.target);
            }
          },
          { threshold: 0.12, rootMargin: "0px 0px -7% 0px" }
        );

        revealTargets.forEach((element, index) => {
          element.classList.add("motion-reveal");
          element.style.setProperty("--motion-delay", `${Math.min(index % 4, 3) * 55}ms`);

          if (element.getBoundingClientRect().top < window.innerHeight * 0.92) {
            requestAnimationFrame(() => element.classList.add("motion-visible"));
          } else {
            revealObserver.observe(element);
          }
        });

        const radioPanel = document.querySelector<HTMLElement>(
          ".home-midnight-blue .radio-panel"
        );

        if (radioPanel) {
          const resetPanel = () => {
            radioPanel.style.setProperty("--pointer-x", "72%");
            radioPanel.style.setProperty("--pointer-y", "22%");
            radioPanel.style.transform = "perspective(1100px) rotateX(0deg) rotateY(0deg) scale(1)";
          };

          radioPanel.addEventListener("pointermove", (event) => {
            if (event.pointerType === "touch") return;
            const bounds = radioPanel.getBoundingClientRect();
            const x = (event.clientX - bounds.left) / bounds.width;
            const y = (event.clientY - bounds.top) / bounds.height;
            const rotateY = (x - 0.5) * 6;
            const rotateX = (0.5 - y) * 4.5;

            radioPanel.style.setProperty("--pointer-x", `${x * 100}%`);
            radioPanel.style.setProperty("--pointer-y", `${y * 100}%`);
            radioPanel.style.transform = `perspective(1100px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale(1.008)`;
          });

          radioPanel.addEventListener("pointerleave", resetPanel);
          radioPanel.addEventListener("blur", resetPanel, true);
          resetPanel();
        }
      }
    </script>
  </body>
</html>

<style is:global>
  .skip-link {
    position: fixed;
    z-index: 1000;
    top: 12px;
    left: 12px;
    padding: .75rem 1rem;
    border-radius: 10px;
    color: white;
    background: #182230;
    box-shadow: 0 8px 24px rgba(24, 34, 48, .25);
    transform: translateY(-160%);
    transition: transform .18s ease;
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  /* Public-site motion: deliberately subtle, and disabled when reduced motion is requested. */
  @media (prefers-reduced-motion: no-preference) {
    .motion-enabled main {
      animation: public-page-enter .55s cubic-bezier(.2,.75,.2,1) both;
    }

    .motion-enabled .motion-reveal {
      opacity: 0;
      filter: blur(5px);
      transform: translateY(20px);
      transition:
        opacity .62s cubic-bezier(.2,.75,.2,1) var(--motion-delay, 0ms),
        transform .62s cubic-bezier(.2,.75,.2,1) var(--motion-delay, 0ms),
        filter .62s ease var(--motion-delay, 0ms);
    }

    .motion-enabled .motion-reveal.motion-visible {
      opacity: 1;
      filter: blur(0);
      transform: translateY(0);
    }

    @keyframes public-page-enter {
      from { opacity: .001; }
      to { opacity: 1; }
    }
  }

  /* Homepage RX console — modern glass receiver with a live, restrained radio feel. */
  .home-midnight-blue main .radio-panel {
    --pointer-x: 72%;
    --pointer-y: 22%;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border: 1px solid transparent;
    border-radius: 28px;
    background:
      linear-gradient(150deg, rgba(39,57,82,.96), rgba(20,33,51,.98)) padding-box,
      linear-gradient(135deg, rgba(101,215,177,.62), rgba(78,168,255,.3) 36%, rgba(145,133,255,.52) 72%, rgba(244,201,93,.3)) border-box;
    box-shadow:
      0 36px 90px rgba(4,10,20,.38),
      0 0 80px rgba(78,168,255,.08),
      inset 0 1px 0 rgba(255,255,255,.08),
      inset 0 -1px 0 rgba(7,15,29,.45);
    backdrop-filter: blur(18px) saturate(1.08);
    transform-style: preserve-3d;
    transform: perspective(1100px) rotateX(0deg) rotateY(0deg) scale(1);
    translate: 0 0;
    transition: transform .18s ease-out, box-shadow .3s ease, border-color .3s ease;
    will-change: transform, translate;
  }

  .home-midnight-blue main .radio-panel::before {
    content: "";
    position: absolute;
    z-index: 0;
    inset: -35%;
    pointer-events: none;
    background:
      radial-gradient(circle at var(--pointer-x) var(--pointer-y), rgba(101,215,177,.17), transparent 23%),
      radial-gradient(circle at 17% 82%, rgba(145,133,255,.15), transparent 25%),
      radial-gradient(circle at 82% 68%, rgba(78,168,255,.11), transparent 22%);
    filter: blur(3px);
  }

  .home-midnight-blue main .radio-panel::after {
    content: "";
    position: absolute;
    z-index: 1;
    top: -30%;
    bottom: -30%;
    left: -40%;
    width: 28%;
    pointer-events: none;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,.055), transparent);
    transform: skewX(-16deg);
  }

  .home-midnight-blue main .radio-panel > * {
    position: relative;
    z-index: 2;
  }

  .home-midnight-blue main .radio-panel .panel-top,
  .home-midnight-blue main .radio-panel .panel-bottom {
    border: 0;
    background: rgba(9,18,31,.48);
    backdrop-filter: blur(12px);
  }

  .home-midnight-blue main .radio-panel .panel-top {
    min-height: 50px;
    padding: 12px 16px;
    border-bottom: 1px solid rgba(244,247,251,.09);
  }

  .home-midnight-blue main .radio-panel .panel-top::before {
    content: "";
    flex: 0 0 auto;
    width: 7px;
    height: 7px;
    margin-right: 30px;
    border-radius: 50%;
    background: #ff7b76;
    box-shadow: 13px 0 #f4c95d, 26px 0 #65d7b1;
    opacity: .88;
  }

  .home-midnight-blue main .radio-panel .panel-top span {
    margin-right: auto;
    color: #a9bad0;
    letter-spacing: .14em;
  }

  .home-midnight-blue main .radio-panel .panel-top strong {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 8px;
    border: 1px solid rgba(101,215,177,.18);
    border-radius: 999px;
    color: #8be8c7;
    background: rgba(101,215,177,.07);
    text-shadow: 0 0 18px rgba(101,215,177,.28);
  }

  .home-midnight-blue main .radio-panel .vfo {
    margin: 13px 16px 0;
    padding: 19px 18px;
    border: 1px solid rgba(244,247,251,.09);
    border-radius: 17px;
    background:
      linear-gradient(135deg, rgba(255,255,255,.035), transparent 48%),
      rgba(15,28,45,.52);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.025);
    transition: transform .25s ease, border-color .25s ease, background .25s ease;
  }

  .home-midnight-blue main .radio-panel .vfo.active {
    border-color: rgba(101,215,177,.24);
    background:
      radial-gradient(circle at 18% 40%, rgba(101,215,177,.10), transparent 36%),
      linear-gradient(135deg, rgba(255,255,255,.045), transparent 50%),
      rgba(15,28,45,.58);
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,.035),
      0 0 34px rgba(101,215,177,.045);
  }

  .home-midnight-blue main .radio-panel .vfo small {
    color: #a4b7cd;
  }

  .home-midnight-blue main .radio-panel .vfo b {
    margin-top: 7px;
    letter-spacing: -.075em;
  }

  .home-midnight-blue main .radio-panel .vfo.active b {
    color: #78e3be;
    text-shadow: 0 0 28px rgba(101,215,177,.18);
  }

  .home-midnight-blue main .radio-panel .vfo > span {
    min-width: 66px;
    padding: 7px 8px;
    border: 1px solid rgba(244,247,251,.07);
    border-radius: 10px;
    background: rgba(14,26,42,.46);
    color: #9fb4cd;
  }

  .home-midnight-blue main .radio-panel .meter {
    margin: 13px 16px 0;
    padding: 11px 12px;
    border: 1px solid rgba(244,247,251,.075);
    border-radius: 13px;
    background: rgba(12,24,39,.48) !important;
  }

  .home-midnight-blue main .radio-panel .meter > div {
    gap: 4px;
  }

  .home-midnight-blue main .radio-panel .meter i {
    height: 6px;
    border-radius: 999px;
    background: rgba(151,174,201,.12);
  }

  .home-midnight-blue main .radio-panel .meter i.on {
    background: linear-gradient(90deg, #f4c95d, #ffdd81);
    box-shadow: 0 0 11px rgba(244,201,93,.12);
  }

  .home-midnight-blue main .radio-panel .scope {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    height: 146px;
    margin: 12px 16px 13px;
    padding: 15px 13px 12px;
    border: 1px solid rgba(78,168,255,.12);
    border-radius: 17px;
    background:
      linear-gradient(rgba(142,167,195,.055) 1px, transparent 1px),
      linear-gradient(90deg, rgba(142,167,195,.045) 1px, transparent 1px),
      radial-gradient(circle at 50% 110%, rgba(145,133,255,.10), transparent 46%),
      rgba(10,22,37,.66);
    background-size: 100% 25%, 8.33% 100%, auto, auto;
    box-shadow: inset 0 0 38px rgba(4,12,24,.22);
  }

  .home-midnight-blue main .radio-panel .scope::before {
    content: "";
    position: absolute;
    z-index: 0;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(180deg, rgba(78,168,255,.055), transparent 26%, transparent 72%, rgba(145,133,255,.045));
  }

  .home-midnight-blue main .radio-panel .scope::after {
    content: "";
    position: absolute;
    z-index: 2;
    top: 0;
    bottom: 0;
    left: -22%;
    width: 20%;
    pointer-events: none;
    background: linear-gradient(90deg, transparent, rgba(101,215,177,.12), rgba(78,168,255,.08), transparent);
    filter: blur(2px);
  }

  .home-midnight-blue main .radio-panel .scope i {
    z-index: 1;
    min-width: 2px;
    border-radius: 999px 999px 2px 2px;
    background: linear-gradient(180deg, #63b7ff 0%, #7fa4ff 45%, #9b87ff 100%);
    box-shadow: 0 0 8px rgba(78,168,255,.08);
    opacity: .88;
    transform-origin: bottom;
  }

  .home-midnight-blue main .radio-panel .panel-bottom {
    margin: 0 16px 16px;
    padding: 10px 12px;
    border: 1px solid rgba(244,247,251,.07);
    border-radius: 12px;
    color: #93aac4;
  }

  .home-midnight-blue main .radio-panel .panel-bottom span {
    padding: 4px 7px;
    border-radius: 7px;
    background: rgba(255,255,255,.025);
  }

  .home-midnight-blue main .radio-panel .panel-bottom b {
    color: #ffd96f;
    text-shadow: 0 0 18px rgba(244,201,93,.12);
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .home-midnight-blue main .radio-panel {
      animation: rx-console-float 6.5s ease-in-out infinite;
    }

    .home-midnight-blue main .radio-panel:hover {
      box-shadow:
        0 42px 105px rgba(4,10,20,.46),
        0 0 95px rgba(78,168,255,.11),
        inset 0 1px 0 rgba(255,255,255,.10),
        inset 0 -1px 0 rgba(7,15,29,.42);
    }

    .home-midnight-blue main .radio-panel:hover::after {
      animation: rx-console-sheen 2.6s ease-out 1;
    }

    .home-midnight-blue main .radio-panel .vfo:hover {
      transform: translateX(3px);
      border-color: rgba(78,168,255,.18);
    }

    .home-midnight-blue main .radio-panel .panel-top strong {
      animation: rx-status-pulse 2.2s ease-in-out infinite;
    }

    .home-midnight-blue main .radio-panel .scope::after {
      animation: rx-scan 4.4s linear infinite;
    }

    .home-midnight-blue main .radio-panel .scope i {
      animation: rx-spectrum 1.65s ease-in-out infinite alternate;
    }

    .home-midnight-blue main .radio-panel .scope i:nth-child(4n + 1) { animation-delay: -.25s; animation-duration: 1.95s; }
    .home-midnight-blue main .radio-panel .scope i:nth-child(4n + 2) { animation-delay: -.9s; animation-duration: 1.45s; }
    .home-midnight-blue main .radio-panel .scope i:nth-child(4n + 3) { animation-delay: -.55s; animation-duration: 1.8s; }
    .home-midnight-blue main .radio-panel .scope i:nth-child(4n) { animation-delay: -1.2s; animation-duration: 2.1s; }

    .home-midnight-blue .status-line i {
      animation: rx-status-dot 2s ease-in-out infinite;
    }
  }

  @keyframes rx-console-float {
    0%, 100% { translate: 0 0; }
    50% { translate: 0 -7px; }
  }

  @keyframes rx-console-sheen {
    0% { left: -40%; opacity: 0; }
    18% { opacity: 1; }
    100% { left: 125%; opacity: 0; }
  }

  @keyframes rx-status-pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(101,215,177,0); }
    50% { box-shadow: 0 0 0 5px rgba(101,215,177,.035), 0 0 18px rgba(101,215,177,.08); }
  }

  @keyframes rx-scan {
    0% { left: -24%; }
    100% { left: 112%; }
  }

  @keyframes rx-spectrum {
    0% { transform: scaleY(.72); opacity: .66; }
    100% { transform: scaleY(1.08); opacity: .96; }
  }

  @keyframes rx-status-dot {
    0%, 100% { opacity: .72; box-shadow: 0 0 8px rgba(101,215,177,.22); }
    50% { opacity: 1; box-shadow: 0 0 18px rgba(101,215,177,.58); }
  }

  @media (max-width: 620px) {
    .home-midnight-blue main .radio-panel {
      border-radius: 22px;
    }

    .home-midnight-blue main .radio-panel .panel-top::before {
      display: none;
    }

    .home-midnight-blue main .radio-panel .vfo {
      margin-inline: 11px;
      padding-inline: 14px;
    }

    .home-midnight-blue main .radio-panel .meter,
    .home-midnight-blue main .radio-panel .scope,
    .home-midnight-blue main .radio-panel .panel-bottom {
      margin-inline: 11px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .motion-reveal,
    .motion-visible {
      opacity: 1 !important;
      filter: none !important;
      transform: none !important;
    }

    .home-midnight-blue main .radio-panel,
    .home-midnight-blue main .radio-panel *,
    .home-midnight-blue main .radio-panel::before,
    .home-midnight-blue main .radio-panel::after {
      animation: none !important;
      transition-duration: .01ms !important;
    }
  }
</style>
