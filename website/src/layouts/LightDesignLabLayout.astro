---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  concept: string;
  themeColor?: string;
}

const {
  title,
  description,
  concept,
  themeColor = "#f7f8fb",
} = Astro.props;

const concepts = [
  ["light", "Vue claire"],
  ["swiss-signal", "01 Swiss Signal"],
  ["paper-radio", "02 Paper Radio"],
  ["soft-spectrum", "03 Soft Spectrum"],
  ["civic-tech", "04 Civic Tech"],
  ["polar-neon", "05 Polar Neon"],
  ["ham-shack", "06 Ham Shack"],
];
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content={themeColor} />
    <meta name="color-scheme" content="light" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title} — RadioPack Design Lab</title>
  </head>
  <body class={`light-design-lab theme-${concept}`}>
    <a class="light-lab-skip" href="#light-design-concept">Aller au concept</a>
    <nav class="light-lab-nav" aria-label="Navigation des concepts clairs">
      <a class="light-lab-brand" href="/design-lab/light/">
        <img src="/brand/b2tech-logo.png" alt="" />
        <span><strong>RADIOPACK</strong><small>LIGHT LAB</small></span>
      </a>
      <div class="light-lab-links">
        {concepts.map(([slug, label]) => (
          <a class={slug === concept ? "is-active" : ""} href={slug === "light" ? "/design-lab/light/" : `/design-lab/light/${slug}/`}>{label}</a>
        ))}
      </div>
      <a class="dark-lab-link" href="/design-lab/">Thèmes sombres ↗</a>
    </nav>
    <main id="light-design-concept"><slot /></main>
  </body>
</html>

<style is:global>
  body.light-design-lab {
    margin: 0;
    min-width: 320px;
    color: #14171d;
    background: #f7f8fb;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }
  body.light-design-lab::before { display: none; }
  .light-design-lab *, .light-design-lab *::before, .light-design-lab *::after { box-sizing: border-box; }
  .light-design-lab a { color: inherit; text-decoration: none; }
  .light-lab-skip {
    position: fixed; z-index: 500; left: 14px; top: 14px; padding: 10px 14px;
    background: #11151d; color: white !important; border-radius: 8px; transform: translateY(-180%);
  }
  .light-lab-skip:focus { transform: translateY(0); }
  .light-lab-nav {
    position: sticky; top: 0; z-index: 100; display: flex; align-items: center; justify-content: space-between; gap: 16px;
    min-height: 70px; padding: 10px max(18px, calc((100vw - 1280px) / 2));
    border-bottom: 1px solid rgba(20,23,29,.1); background: rgba(250,251,253,.9); backdrop-filter: blur(18px);
  }
  .light-lab-brand { display: flex; align-items: center; gap: 10px; flex: 0 0 auto; }
  .light-lab-brand img { width: 38px; height: 38px; object-fit: contain; }
  .light-lab-brand span { display: grid; line-height: 1; }
  .light-lab-brand strong { font-size: .78rem; letter-spacing: .14em; }
  .light-lab-brand small { margin-top: 5px; color: #718096; font-size: .57rem; letter-spacing: .22em; }
  .light-lab-links { display: flex; align-items: center; gap: 5px; overflow-x: auto; scrollbar-width: none; }
  .light-lab-links::-webkit-scrollbar { display: none; }
  .light-lab-links a { flex: 0 0 auto; padding: 8px 9px; border-radius: 8px; color: #687385; font-size: .69rem; font-weight: 800; letter-spacing: .03em; }
  .light-lab-links a:hover, .light-lab-links a.is-active { color: #11151d; background: #e8edf5; }
  .dark-lab-link { flex: 0 0 auto; padding: 8px 11px; border: 1px solid #dce2eb; border-radius: 999px; color: #384457 !important; font-size: .68rem; font-weight: 850; }
  @media (max-width: 980px) {
    .light-lab-nav { align-items: flex-start; flex-wrap: wrap; padding: 10px 14px; }
    .light-lab-links { order: 3; width: 100%; padding-bottom: 2px; }
  }
</style>
