---
interface Props { icon: string; title: string; description: string; tone?: "purple" | "blue" | "orange" | "green"; }
const { icon, title, description, tone = "purple" } = Astro.props;
---
<article class:list={["feature", `tone-${tone}`]}>
  <div class="icon" aria-hidden="true">{icon}</div>
  <div><h3>{title}</h3><p>{description}</p></div>
</article>
<style>
  .feature { display: grid; grid-template-columns: 52px 1fr; gap: 15px; padding: 22px; border-radius: 18px; border: 1px solid var(--line); background: rgba(255,255,255,.72); box-shadow: var(--shadow-soft); }
  .icon { display: grid; place-items: center; width: 52px; height: 52px; border-radius: 14px; font-size: 1.4rem; background: rgba(110,61,232,.12); }
  h3 { margin-bottom: 7px; }
  p { color: var(--muted); font-size: .91rem; }
  .tone-blue .icon { background: rgba(22,135,233,.13); }
  .tone-orange .icon { background: rgba(240,154,32,.16); }
  .tone-green .icon { background: rgba(16,164,122,.13); }
</style>
