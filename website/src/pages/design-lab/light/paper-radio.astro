---
import LightDesignLabLayout from "../../../layouts/LightDesignLabLayout.astro";
import { publicPacks } from "../../../lib/packRegistry";
const order = ["normandie", "annecy-alpes-leman", "bretagne"];
const packs = order.map((id) => publicPacks.find((pack) => pack.id === id)).filter(Boolean).map((pack: any) => ({ ...pack, count: pack.variants.find((v: any) => v.id === pack.defaultVariant)?.memoryCount ?? pack.variants[0]?.memoryCount ?? 0 }));
---
<LightDesignLabLayout title="Paper Radio" description="Concept clair Paper Radio pour RadioPack France." concept="paper-radio" themeColor="#f4f0e6">
  <div class="paper">
    <section class="masthead wrap"><div><small>B2TECH STUDIO PRÉSENTE</small><h1>RadioPack<br />France</h1></div><aside><b>ÉDITION PUBLIQUE</b><p>Packs CHIRP régionaux pour Quansheng UV-K5, préparés à partir de sources publiques vérifiables.</p></aside></section>
    <div class="rule wrap"><span>RÉCEPTION SEULE</span><span>VERSIONS IMMUTABLES</span><span>DONNÉES SOURCÉES</span></div>
    <section class="feature wrap"><div class="number">01</div><div><small>LE DOSSIER</small><h2>Écouter une région sans transformer sa radio en tableau illisible.</h2><p>Une approche éditoriale, plus proche d’un beau guide imprimé que d’un dashboard logiciel.</p></div><div class="stamp">RX<br /><b>ONLY</b></div></section>
    <section class="packs wrap"><div class="title"><span>LES ÉDITIONS RÉGIONALES</span><i></i></div><div class="grid">{packs.map((pack:any,i)=><a class="card" href={`/regions/${pack.regionSlug}`}><small>N° 0{i+1} · {pack.version}</small><h3>{pack.name}</h3><p>{pack.count} mémoires sélectionnées et organisées.</p><span>Consulter l’édition →</span></a>)}</div></section>
    <section class="quote wrap"><span>“</span><p>Le bon codeplug n’est pas celui qui contient tout. C’est celui dont on comprend immédiatement le contenu.</p></section>
  </div>
</LightDesignLabLayout>
<style>
  .paper{min-height:100vh;background:#f4f0e6;color:#20231e;font-family:Georgia,"Times New Roman",serif;background-image:radial-gradient(rgba(28,32,27,.035) .7px,transparent .7px);background-size:7px 7px}
  .wrap{width:min(1140px,calc(100% - 36px));margin:auto}.masthead{display:grid;grid-template-columns:1.5fr .65fr;gap:60px;padding:74px 0 42px;align-items:end}.masthead small,.masthead b,.feature small,.card small{font-family:Arial,sans-serif;font-size:.67rem;letter-spacing:.16em}.masthead h1{margin:15px 0 0;font-size:clamp(4.6rem,11vw,9.3rem);line-height:.77;letter-spacing:-.065em;font-weight:500}.masthead aside{padding:24px 0 8px;border-top:4px solid #1f5c4a}.masthead aside b{color:#1f5c4a}.masthead aside p{line-height:1.6}.rule{display:flex;justify-content:space-between;gap:18px;padding:12px 0;border-top:1px solid #282b25;border-bottom:1px solid #282b25;font-family:Arial,sans-serif;font-size:.65rem;font-weight:850;letter-spacing:.1em}.feature{display:grid;grid-template-columns:90px 1fr 150px;gap:38px;padding:70px 0;border-bottom:1px solid #8b887d}.number{font-size:4rem;color:#d86a34}.feature h2{margin:12px 0 18px;max-width:800px;font-size:clamp(2.4rem,5.4vw,5.2rem);line-height:.97;font-weight:500;letter-spacing:-.035em}.feature p{max-width:620px;font-size:1.08rem;line-height:1.7}.stamp{align-self:center;justify-self:end;width:120px;height:120px;display:grid;place-content:center;text-align:center;border:2px solid #1f5c4a;border-radius:50%;color:#1f5c4a;transform:rotate(7deg);font-family:Arial,sans-serif;font-size:.8rem;letter-spacing:.12em}.stamp b{font-size:1.35rem}.packs{padding:70px 0}.title{display:flex;align-items:center;gap:20px;font-family:Arial,sans-serif;font-size:.67rem;font-weight:900;letter-spacing:.15em;color:#1f5c4a}.title i{height:1px;background:#1f5c4a;flex:1}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:0;margin-top:28px;border-top:1px solid #8b887d;border-bottom:1px solid #8b887d}.card{padding:32px 28px 34px;border-right:1px solid #8b887d}.card:last-child{border-right:0}.card h3{margin:34px 0 16px;font-size:clamp(1.7rem,3vw,2.7rem);font-weight:500}.card p{min-height:60px;color:#5e605a;line-height:1.55}.card>span{display:block;margin-top:28px;color:#d86a34;font-family:Arial,sans-serif;font-size:.75rem;font-weight:900}.quote{display:grid;grid-template-columns:90px 1fr;gap:20px;padding:34px 0 90px;border-top:5px solid #20231e}.quote span{font-size:5rem;color:#d86a34;line-height:1}.quote p{margin:0;max-width:900px;font-size:clamp(1.8rem,4vw,3.6rem);line-height:1.1;font-style:italic}@media(max-width:760px){.masthead,.feature{grid-template-columns:1fr}.stamp{justify-self:start}.rule{flex-direction:column}.grid{grid-template-columns:1fr}.card{border-right:0;border-bottom:1px solid #8b887d}.card:last-child{border-bottom:0}}
</style>
