---
import BaseLayout from "../layouts/BaseLayout.astro";
import { publicPacks } from "../lib/packRegistry";

const regionalPacks = publicPacks;
const totalMemories = regionalPacks.reduce((sum, pack) => {
  const variant = pack.variants.find((item) => item.id === pack.defaultVariant) ?? pack.variants[0];
  return sum + (variant?.memoryCount ?? 0);
}, 0);

const nationalDownloads = [
  {
    title: "Canaux d'appel radioamateur",
    description: "145,500 MHz en 2 m et 433,500 MHz en 70 cm, réception seule.",
    href: "/downloads/national/radiopack-france-amateur-calls-rx.csv",
    label: "CSV appels radioamateur",
    tone: "signal",
  },
  {
    title: "France — VHF marine RX",
    description: "Plan d'écoute VHF marine public, disponible comme module national complémentaire.",
    href: "/downloads/national/radiopack-france-marine-vhf-rx.csv",
    label: "CSV VHF marine",
    tone: "blue",
  },
  {
    title: "France — PMR446 RX",
    description: "Les 16 canaux analogiques PMR446 en réception seule.",
    href: "/downloads/national/radiopack-france-pmr446-rx.csv",
    label: "CSV PMR446",
    tone: "rx",
  },
  {
    title: "France — APRS & ISS RX",
    description: "Module d'écoute APRS, ISS et fréquences radioamateur publiques associées.",
    href: "/downloads/national/radiopack-france-amateur-listening-rx.csv",
    label: "CSV APRS / ISS",
    tone: "violet",
  },
];
---

<BaseLayout
  title="Téléchargements — RadioPack France"
  description="Télécharge les variantes CSV CHIRP publiques et RX-only actuellement publiées par RadioPack France."
  themeColor="#182538"
  colorScheme="dark"
>
  <section class="section downloads-page">
    <div class="container">
      <span class="eyebrow">Fichiers publics · RX only</span>
      <div class="page-head">
        <div>
          <h1>Téléchargements</h1>
          <p class="lead">
            {regionalPacks.length} packs publics sont disponibles, dont les 13 régions administratives métropolitaines,
            pour un total de {totalMemories} mémoires dans leurs variantes par défaut.
          </p>
        </div>
        <div class="rx-status"><span>●</span><strong>TX bloquée</strong><small>Duplex=off dans les CSV publics</small></div>
      </div>

      <div class="notice card">
        <div class="notice-icon">RX</div>
        <div>
          <strong>Réception seule par conception</strong>
          <p>La présence d'une fréquence dans un pack ne constitue jamais une autorisation d'émettre. Les versions publiées restent identifiables et immuables.</p>
        </div>
      </div>

      <div class="section-heading regional-heading">
        <div><span class="section-code">MEMORY BANKS</span><h2>Packs régionaux</h2></div>
        <p class="muted">Versions et liens alimentés directement par <code>packRegistry.ts</code>.</p>
      </div>

      <div class="regional-list">
        {regionalPacks.map((pack, index) => {
          const defaultVariant = pack.variants.find((variant) => variant.id === pack.defaultVariant) ?? pack.variants[0];
          return (
            <article class="regional-card card">
              <div class="bank-id">B{String(index + 1).padStart(2, "0")}</div>
              <div class="regional-main">
                <span class="badge badge-green">{pack.status} · {pack.version}</span>
                <h2>{pack.name}</h2>
                <p>{pack.description}</p>
                <div class="variant-buttons">
                  {pack.variants.map((variant) => (
                    <a class:list={["button", variant.id === pack.defaultVariant ? "button-primary" : "button-secondary"]} href={variant.downloadUrl} download={variant.filename}>
                      {variant.label} · {variant.memoryCount} mémoires
                    </a>
                  ))}
                </div>
              </div>
              <div class="regional-count">
                <strong>{defaultVariant?.memoryCount ?? 0}</strong>
                <span>MEM</span>
                <small>variante par défaut</small>
              </div>
            </article>
          );
        })}
      </div>

      <div class="section-heading module-heading">
        <div><span class="section-code">MODULES RX</span><h2>Fichiers nationaux complémentaires</h2></div>
        <p class="muted">Blocs réutilisables pour l'écoute et la composition manuelle.</p>
      </div>

      <div class="grid-2 national-grid">
        {nationalDownloads.map((item) => (
          <article class:list={["download-card", "card", `tone-${item.tone}`]}>
            <span class="module-dot"></span>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
            <a class="button button-secondary" href={item.href} download>{item.label}</a>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .downloads-page{padding-top:72px}.page-head{display:grid;grid-template-columns:1fr auto;gap:36px;align-items:end;margin-top:18px}.page-head h1{font-size:clamp(3.4rem,8vw,6.2rem);margin-bottom:18px}.page-head .lead{max-width:860px}.rx-status{display:grid;min-width:210px;padding:18px;border:1px solid var(--line);border-radius:16px;background:var(--surface)}.rx-status span{color:var(--green);font-size:.8rem}.rx-status strong{margin-top:6px;font-family:"Space Grotesk",sans-serif;font-size:1.2rem}.rx-status small{margin-top:4px;color:var(--muted)}.notice{display:grid;grid-template-columns:54px 1fr;gap:17px;align-items:start;margin:34px 0 76px;padding:22px}.notice-icon{display:grid;place-items:center;width:54px;height:54px;border-radius:14px;font:900 .78rem "SFMono-Regular",Consolas,monospace;background:rgba(101,215,177,.12);color:var(--green)}.notice p{margin-top:5px;color:var(--muted)}.section-code{color:var(--blue);font-size:.68rem;font-weight:900;letter-spacing:.16em}.regional-heading,.module-heading{margin-bottom:24px}.regional-list{border-top:1px solid var(--line)}.regional-card{display:grid;grid-template-columns:70px 1fr 135px;gap:24px;align-items:center;padding:28px 20px;border-width:0 0 1px;border-radius:0;box-shadow:none;background:transparent}.bank-id{color:var(--blue);font:900 1rem "SFMono-Regular",Consolas,monospace}.regional-main{display:grid;gap:12px}.regional-main h2{font-size:clamp(1.7rem,3.4vw,2.7rem)}.regional-main p{max-width:780px;color:var(--muted)}.variant-buttons{display:flex;flex-wrap:wrap;gap:10px;margin-top:4px}.regional-count{display:grid;justify-items:end}.regional-count strong{font-family:"Space Grotesk",sans-serif;font-size:3rem;line-height:.88;letter-spacing:-.06em}.regional-count span{margin-top:5px;color:var(--orange);font:900 .67rem "SFMono-Regular",Consolas,monospace;letter-spacing:.1em}.regional-count small{margin-top:5px;color:var(--muted);font-size:.68rem}.module-heading{margin-top:88px}.national-grid{padding-bottom:28px}.download-card{position:relative;display:grid;gap:14px;min-height:230px;padding:25px;overflow:hidden}.download-card h3{margin-top:38px;font-size:1.45rem}.download-card p{color:var(--muted)}.download-card .button{justify-self:start;margin-top:auto}.module-dot{position:absolute;top:24px;left:25px;width:9px;height:9px;border-radius:50%;background:var(--blue);box-shadow:0 0 18px rgba(78,168,255,.4)}.tone-signal .module-dot{background:var(--orange)}.tone-rx .module-dot{background:var(--green)}.tone-violet .module-dot{background:var(--purple)}@media(max-width:800px){.page-head{grid-template-columns:1fr}.rx-status{width:fit-content}.regional-card{grid-template-columns:50px 1fr}.regional-count{grid-column:2;justify-items:start}}@media(max-width:560px){.regional-card{padding-inline:4px;gap:12px}.variant-buttons .button{width:100%}}
</style>
