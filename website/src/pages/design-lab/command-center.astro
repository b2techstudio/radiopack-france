---
import DesignLabLayout from "../../layouts/DesignLabLayout.astro";
import { publicPacks } from "../../lib/packRegistry";
const packs = publicPacks.map((pack) => ({...pack,count:pack.variants.find((v)=>v.id===pack.defaultVariant)?.memoryCount ?? pack.variants[0]?.memoryCount ?? 0}));
const total = packs.reduce((sum,pack)=>sum+pack.count,0);
---
<DesignLabLayout title="Radio Command Center" description="Concept console de contrôle radio pour RadioPack France." concept="command-center" themeColor="#03070B">
  <div class="console-page">
    <section class="command-hero wrap">
      <div class="console-window">
        <div class="window-bar"><span>RADIOPACK CONTROL / NODE FR-01</span><div><i></i><i></i><i></i></div></div>
        <div class="dashboard-grid">
          <div class="primary-display">
            <small>PUBLIC RECEIVE NETWORK</small>
            <h1>RADIOPACK<br /><span>COMMAND</span></h1>
            <p>Console de sélection et de génération des packs CHIRP publics. Statuts, versions et mémoire disponibles au même endroit.</p>
            <div class="cmd-actions"><a href="/generateur">[ OUVRIR GÉNÉRATEUR ]</a><a href="/regions">[ PACKS RÉGIONAUX ]</a></div>
          </div>
          <div class="frequency-panel">
            <div class="freq-title"><span>RX MONITOR</span><b>● LIVE</b></div>
            <div class="freq"><small>VHF</small><strong>145.500</strong><em>MHz</em></div>
            <div class="freq secondary"><small>UHF</small><strong>433.500</strong><em>MHz</em></div>
            <div class="spectrum" aria-hidden="true">{Array.from({length:34}).map((_,i)=><i style={`height:${10+((i*13)%38)}px`}></i>)}</div>
            <div class="readouts"><span>SQUELCH <b>03</b></span><span>MODE <b>RX</b></span><span>TX <b>OFF</b></span></div>
          </div>
          <div class="kpi k1"><small>PACKS ONLINE</small><strong>{packs.length}</strong><span>PUBLIC</span></div>
          <div class="kpi k2"><small>MEMORIES</small><strong>{total}</strong><span>DEFAULT SETS</span></div>
          <div class="kpi k3"><small>SECURITY</small><strong>OK</strong><span>CI VERIFIED</span></div>
        </div>
      </div>
    </section>

    <section class="modules wrap">
      <div class="module-title"><span>PACK MODULES</span><small>SELECT TARGET REGION</small></div>
      <div class="module-grid">
        {packs.map((pack,index)=>(
          <a href={`/regions/${pack.regionSlug}`} class="module-card">
            <div class="module-head"><span>MOD-0{index+1}</span><b>ACTIVE ●</b></div>
            <h2>{pack.name}</h2>
            <div class="module-data"><div><small>VERSION</small><strong>{pack.version}</strong></div><div><small>CHANNELS</small><strong>{pack.count}</strong></div><div><small>POLICY</small><strong>RX</strong></div></div>
            <div class="progress"><i style={`width:${Math.min(100,pack.count/2)}%`}></i></div>
            <div class="module-foot"><span>LOAD PACK DATA</span><b>ENTER ↵</b></div>
          </a>
        ))}
      </div>
    </section>

    <section class="ops wrap">
      <div><span>SYS / SOURCE</span><strong>PUBLIC VERIFIED DATA</strong><small>Pas de fréquence privée ou inférée.</small></div>
      <div><span>SYS / OUTPUT</span><strong>CHIRP CSV</strong><small>RX-only et versions immuables.</small></div>
      <div><span>SYS / BUILD</span><strong>CI GREEN</strong><small>Contrôles automatisés avant publication.</small></div>
      <a href="/generateur"><span>SYS / ACTION</span><strong>BUILD YOUR PACK →</strong><small>Composer un fichier depuis les packs publics.</small></a>
    </section>
  </div>
</DesignLabLayout>

<style>
  .console-page{min-height:100vh;color:#dffcff;background:#03070b;background-image:linear-gradient(rgba(0,229,255,.045) 1px,transparent 1px),linear-gradient(90deg,rgba(0,229,255,.045) 1px,transparent 1px);background-size:28px 28px;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace}.wrap{width:min(1260px,calc(100% - 34px));margin-inline:auto}
  .command-hero{padding:54px 0 30px}.console-window{border:1px solid #1b3a43;background:rgba(4,12,17,.94);box-shadow:0 0 70px rgba(0,229,255,.05)}.window-bar{display:flex;justify-content:space-between;align-items:center;padding:11px 14px;border-bottom:1px solid #17333b;color:#6fc4cb;font-size:.65rem;letter-spacing:.12em}.window-bar div{display:flex;gap:7px}.window-bar i{width:7px;height:7px;border-radius:50%;background:#18323a}.window-bar i:first-child{background:#8fff00;box-shadow:0 0 10px #8fff00}
  .dashboard-grid{display:grid;grid-template-columns:1.25fr .75fr repeat(3,.36fr);grid-template-areas:"main radio radio radio radio" "main k1 k2 k3 k3";gap:1px;background:#17333b}.primary-display{grid-area:main;min-height:560px;padding:54px;background:linear-gradient(145deg,#061118,#03080c)}.primary-display small{color:#8fff00;font-weight:900;letter-spacing:.18em}.primary-display h1{margin:32px 0 22px;color:#eaffff;font-size:clamp(3.2rem,7vw,7rem);line-height:.82;letter-spacing:-.07em;font-family:Inter,sans-serif}.primary-display h1 span{color:#00e5ff;text-shadow:0 0 28px rgba(0,229,255,.25)}.primary-display p{max-width:600px;color:#74a1aa;line-height:1.8;font-family:Inter,sans-serif}.cmd-actions{display:flex;flex-wrap:wrap;gap:9px;margin-top:35px}.cmd-actions a{padding:12px 14px;border:1px solid #1c5964;color:#8edee5;font-size:.7rem;font-weight:900}.cmd-actions a:hover{border-color:#8fff00;color:#8fff00;background:rgba(143,255,0,.04)}
  .frequency-panel{grid-area:radio;min-height:360px;padding:25px;background:#041017}.freq-title{display:flex;justify-content:space-between;color:#77bcc5;font-size:.65rem;letter-spacing:.12em}.freq-title b{color:#8fff00}.freq{display:grid;grid-template-columns:60px 1fr auto;align-items:end;gap:12px;margin-top:25px}.freq small{color:#587e86}.freq strong{font-size:clamp(2.5rem,5vw,4.9rem);line-height:.85;letter-spacing:-.07em;color:#dffcff}.freq em{color:#00e5ff;font-style:normal;font-size:.72rem}.freq.secondary{margin-top:12px;opacity:.55}.freq.secondary strong{font-size:2rem}.spectrum{display:flex;align-items:end;gap:4px;height:62px;margin-top:25px;padding:9px 0;border-block:1px solid #15323a}.spectrum i{flex:1;max-width:8px;background:linear-gradient(#8fff00,#00e5ff);opacity:.7}.readouts{display:flex;gap:20px;margin-top:12px;color:#52777f;font-size:.62rem}.readouts b{color:#dffcff}
  .kpi{padding:20px;background:#061118}.k1{grid-area:k1}.k2{grid-area:k2}.k3{grid-area:k3}.kpi small{display:block;color:#557d85;font-size:.58rem;letter-spacing:.1em}.kpi strong{display:block;margin:12px 0 5px;color:#8fff00;font-size:2.6rem;line-height:1}.kpi span{color:#6a9da5;font-size:.56rem;letter-spacing:.12em}
  .modules{padding:50px 0 60px}.module-title{display:flex;justify-content:space-between;margin-bottom:13px;color:#8edee5;font-size:.7rem;letter-spacing:.13em}.module-title small{color:#4f747c}.module-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.module-card{min-height:330px;padding:22px;border:1px solid #17333b;background:#051016;transition:.18s ease}.module-card:hover{border-color:#00e5ff;box-shadow:inset 0 0 35px rgba(0,229,255,.035)}.module-head{display:flex;justify-content:space-between;color:#517c84;font-size:.6rem}.module-head b{color:#8fff00}.module-card h2{min-height:86px;margin:42px 0 24px;color:#dffcff;font:900 clamp(1.5rem,3vw,2.25rem)/.95 Inter,sans-serif;letter-spacing:-.04em}.module-data{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.module-data div{padding:10px;border:1px solid #132c34}.module-data small{display:block;color:#496d75;font-size:.54rem}.module-data strong{display:block;margin-top:6px;color:#bfeef2;font-size:.86rem}.progress{height:3px;margin:20px 0;background:#10272e}.progress i{display:block;height:100%;background:#00e5ff;box-shadow:0 0 10px #00e5ff}.module-foot{display:flex;justify-content:space-between;padding-top:13px;border-top:1px solid #122b33;color:#608e97;font-size:.6rem}.module-foot b{color:#8fff00}
  .ops{display:grid;grid-template-columns:repeat(4,1fr);margin-bottom:70px;border:1px solid #17333b}.ops>div,.ops>a{min-height:150px;padding:18px;border-right:1px solid #17333b;background:#040d12}.ops>*:last-child{border-right:0}.ops span,.ops small,.ops strong{display:block}.ops span{color:#50767e;font-size:.58rem;letter-spacing:.1em}.ops strong{margin:24px 0 8px;color:#dffcff;font-size:.86rem}.ops small{color:#51777f;font:400 .72rem/1.5 Inter,sans-serif}.ops a strong{color:#8fff00}
  @media(max-width:980px){.dashboard-grid{grid-template-columns:1fr 1fr;grid-template-areas:"main main" "radio radio" "k1 k2" "k3 k3"}.primary-display{min-height:auto}.module-grid{grid-template-columns:1fr}.ops{grid-template-columns:1fr 1fr}.ops>*{border-bottom:1px solid #17333b}.ops>*:nth-child(2n){border-right:0}}
  @media(max-width:580px){.primary-display{padding:34px 22px}.dashboard-grid{grid-template-columns:1fr;grid-template-areas:"main" "radio" "k1" "k2" "k3"}.frequency-panel{padding:20px}.freq{grid-template-columns:45px 1fr}.freq em{display:none}.ops{grid-template-columns:1fr}.ops>*{border-right:0}.module-title{align-items:flex-start;flex-direction:column;gap:6px}}
</style>
