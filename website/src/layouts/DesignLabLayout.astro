---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  concept: string;
  themeColor?: string;
}

const {
  title,
  description,
  concept,
  themeColor = "#050912",
} = Astro.props;

const concepts = [
  ["lab", "Vue d’ensemble"],
  ["neon-core", "01 Neon Core"],
  ["command-center", "02 Command Center"],
  ["midnight-atlas", "03 Midnight Atlas"],
  ["industrial-signal", "04 Industrial Signal"],
  ["clean-neon", "05 Clean Neon"],
];
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content={themeColor} />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title} — RadioPack Design Lab</title>
  </head>
  <body class={`design-lab theme-${concept}`}>
    <a class="lab-skip" href="#design-concept">Aller au concept</a>
    <nav class="lab-nav" aria-label="Navigation des concepts de design">
      <a class="lab-brand" href="/design-lab/">
        <img src="/brand/b2tech-logo.png" alt="" />
        <span><strong>RADIOPACK</strong><small>DESIGN LAB</small></span>
      </a>
      <div class="lab-links">
        {concepts.map(([slug, label]) => (
          <a class={slug === concept ? "is-active" : ""} href={slug === "lab" ? "/design-lab/" : `/design-lab/${slug}/`}>{label}</a>
        ))}
      </div>
    </nav>
    <main id="design-concept"><slot /></main>
  </body>
</html>

<style is:global>
  body.design-lab {
    margin: 0;
    min-width: 320px;
    color: #f4f7ff;
    background: #050912;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }
  body.design-lab::before { display: none; }
  .design-lab *, .design-lab *::before, .design-lab *::after { box-sizing: border-box; }
  .design-lab a { color: inherit; text-decoration: none; }
  .lab-skip {
    position: fixed; z-index: 500; left: 14px; top: 14px; padding: 10px 14px;
    background: #fff; color: #050912 !important; border-radius: 8px; transform: translateY(-180%);
  }
  .lab-skip:focus { transform: translateY(0); }
  .lab-nav {
    position: sticky; top: 0; z-index: 100; display: flex; align-items: center; justify-content: space-between; gap: 20px;
    min-height: 70px; padding: 10px max(18px, calc((100vw - 1280px) / 2));
    border-bottom: 1px solid rgba(255,255,255,.1); background: rgba(5,9,18,.88); backdrop-filter: blur(20px);
  }
  .lab-brand { display: flex; align-items: center; gap: 10px; flex: 0 0 auto; }
  .lab-brand img { width: 38px; height: 38px; object-fit: contain; }
  .lab-brand span { display: grid; line-height: 1; }
  .lab-brand strong { font-size: .78rem; letter-spacing: .14em; }
  .lab-brand small { margin-top: 5px; color: #8ea0bd; font-size: .57rem; letter-spacing: .22em; }
  .lab-links { display: flex; align-items: center; gap: 6px; overflow-x: auto; scrollbar-width: none; }
  .lab-links::-webkit-scrollbar { display: none; }
  .lab-links a { flex: 0 0 auto; padding: 8px 10px; border-radius: 8px; color: #98a8c0; font-size: .72rem; font-weight: 800; letter-spacing: .04em; }
  .lab-links a:hover, .lab-links a.is-active { color: white; background: rgba(255,255,255,.08); }
  @media (max-width: 820px) {
    .lab-nav { align-items: flex-start; flex-direction: column; padding: 10px 14px; }
    .lab-links { width: 100%; padding-bottom: 2px; }
  }
</style>
