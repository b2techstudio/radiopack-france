---
import BaseLayout from "../layouts/BaseLayout.astro";
import { defaultPublicPackId, publicPacks } from "../lib/packRegistry";

const defaultPack = publicPacks.find((pack) => pack.id === defaultPublicPackId) ?? publicPacks[0];
const defaultVariant = defaultPack.variants.find((variant) => variant.id === defaultPack.defaultVariant) ?? defaultPack.variants[0];
const metroPacks = publicPacks.filter((pack) => pack.id !== "annecy-alpes-leman");
---
<BaseLayout
  title="Générateur de pack"
  description="Choisis un pack régional RadioPack France puis télécharge directement une variante CSV CHIRP RX-only validée."
>
  <section class="section generator-hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">Générateur web · multi-régions</span>
        <h1>Configure ton <span class="gradient-text">RadioPack</span></h1>
        <p class="lead">
          Les 13 régions métropolitaines sont maintenant disponibles. Choisis une région,
          ajuste les options lorsque le pack en propose, puis télécharge le CSV public déjà validé.
        </p>
        <div class="notice card">
          <strong>Une seule interface pour tous les packs publiés</strong>
          <p>Le générateur sélectionne uniquement des fichiers publics contrôlés. Il ne reconstruit pas de CSV indépendant dans ton navigateur.</p>
        </div>
      </div>

      <aside class="card status-card" aria-label="État du générateur">
        <span class="badge badge-green">{publicPacks.length} packs publiés</span>
        <strong>13 régions métropolitaines + Alpes–Léman</strong>
        <p>Les packs proposés restent configurés en réception seule.</p>
        <dl>
          <div><dt>Duplex</dt><dd>off</dd></div>
          <div><dt>Téléchargement</dt><dd>direct</dd></div>
          <div><dt>CSV côté client</dt><dd>aucun</dd></div>
        </dl>
      </aside>
    </div>
  </section>

  <section class="section-tight">
    <div class="container generator-grid">
      <form class="card generator-form" id="radiopack-generator" novalidate>
        <div class="form-heading">
          <div>
            <span class="badge badge-green" id="pack-badge">{defaultPack.name} {defaultPack.version}</span>
            <h2>Options du pack</h2>
          </div>
          <span class="status-pill published" id="pack-status">{defaultPack.status}</span>
        </div>

        <fieldset>
          <legend>Région</legend>
          <label class="select-label" for="pack-select">Pack régional</label>
          <select id="pack-select" name="pack-select">
            {publicPacks.map((pack) => (
              <option value={pack.id} selected={pack.id === defaultPack.id}>
                {pack.name} · {pack.version}
              </option>
            ))}
          </select>
          <p class="muted" id="pack-description">{defaultPack.description}</p>
        </fieldset>

        <fieldset id="aviation-fieldset">
          <legend>Contenu</legend>
          <label class="option-row" for="include-aviation">
            <span>
              <strong>Inclure les fréquences aviation</strong>
              <small>Annecy : sélectionne la variante complète 77 mémoires ou la variante 60 sans aviation.</small>
            </span>
            <input id="include-aviation" name="include-aviation" type="checkbox" checked />
          </label>
        </fieldset>

        <fieldset id="notam-fieldset">
          <legend>Contrôle opérationnel facultatif</legend>
          <label class="option-row" for="notam-check">
            <span>
              <strong>Contrôle NOTAM avant génération</strong>
              <small>Disponible pour Annecy. Il ne modifie jamais automatiquement les fréquences du CSV.</small>
            </span>
            <input id="notam-check" name="notam-check" type="checkbox" />
          </label>

          <div class="notam-confirm" id="notam-confirm-zone" hidden>
            <p>Les liens officiels ci-dessous permettent une vérification facultative avant téléchargement.</p>
            <div class="notam-links">
              <a href="https://sofia-briefing.aviation-civile.gouv.fr/sofia/pages/notamform.html" target="_blank" rel="noreferrer">SOFIA-Briefing · France ↗</a>
              <a href="https://www.skybriefing.com/fr/services/notam-briefing" target="_blank" rel="noreferrer">Skybriefing · Suisse ↗</a>
            </div>
            <div class="notam-confirm-check">
              <input id="notam-confirmed" name="notam-confirmed" type="checkbox" disabled />
              <label for="notam-confirmed">J'ai vérifié les NOTAM applicables</label>
            </div>
          </div>
        </fieldset>

        <div class="form-actions">
          <a
            class="button button-primary"
            id="download-csv"
            href={defaultVariant.downloadUrl}
            download={defaultVariant.filename}
          >
            Télécharger le CSV · {defaultVariant.memoryCount} mémoires
          </a>
          <a class="button button-secondary" href="/telechargements">Tous les téléchargements</a>
        </div>
      </form>

      <aside class="card summary-card" aria-live="polite">
        <span class="eyebrow">Résumé</span>
        <div class="memory-counter"><strong id="memory-count">{defaultVariant.memoryCount}</strong><span>mémoires</span></div>
        <div class="summary-list">
          <div><span>Pack</span><strong id="pack-summary">{defaultPack.name} {defaultPack.version}</strong></div>
          <div><span>Aviation</span><strong id="aviation-summary">Incluse · 17</strong></div>
          <div><span>NOTAM</span><strong id="notam-summary">Non demandé</strong></div>
          <div><span>Mode</span><strong>Réception seule</strong></div>
          <div><span>Duplex</span><strong>off</strong></div>
          <div class="file-row"><span>Fichier</span><strong id="file-summary">{defaultVariant.filename}</strong></div>
        </div>
        <div class="summary-warning" id="notam-warning">Contrôle NOTAM non demandé. Les fréquences restent celles des sources officielles validées.</div>
        <p class="muted summary-note" id="variant-note">Pour Annecy, retirer l'aviation conserve les emplacements mémoire des autres blocs.</p>
      </aside>
    </div>
  </section>

  <section class="section-tight pack-shortcuts-section">
    <div class="container">
      <div class="shortcut-heading">
        <span class="eyebrow">Raccourcis packs</span>
        <h2>Que signifient ces nombres ?</h2>
        <p>Ils indiquent le <strong>nombre de mémoires présentes dans le CSV publié</strong>. Clique sur une carte pour sélectionner immédiatement ce pack.</p>
      </div>

      <div class="info-grid grid-3 legacy-shortcuts">
        <article class="card info-card pack-shortcut" data-pack-shortcut="annecy-alpes-leman" tabindex="0" role="button" aria-label="Sélectionner le pack Annecy–Alpes–Léman">
          <span class="badge badge-green">Annecy · configurable</span>
          <h3>77 mémoires <small>ou 60 sans aviation</small></h3>
          <p>Le pack complet contient 77 mémoires. Désactiver l'aviation sélectionne la variante publique de 60 mémoires.</p>
          <span class="shortcut-action" aria-hidden="true">Sélectionner ce pack ↑</span>
        </article>
        <article class="card info-card pack-shortcut" data-pack-shortcut="normandie" tabindex="0" role="button" aria-label="Sélectionner le pack Normandie">
          <span class="badge badge-green">Normandie · pack publié</span>
          <h3>142 mémoires</h3>
          <p>Le CSV public Normandie v0.4 contient 142 mémoires RX et est proposé tel quel.</p>
          <span class="shortcut-action" aria-hidden="true">Sélectionner ce pack ↑</span>
        </article>
        <article class="card info-card pack-shortcut" data-pack-shortcut="bretagne" tabindex="0" role="button" aria-label="Sélectionner le pack Bretagne">
          <span class="badge badge-green">Bretagne · pack publié</span>
          <h3>151 mémoires</h3>
          <p>Le CSV public Bretagne v0.2 contient 151 mémoires RX, dont son bloc aviation publié.</p>
          <span class="shortcut-action" aria-hidden="true">Sélectionner ce pack ↑</span>
        </article>
      </div>

      <div class="metro-heading">
        <h2>Les 13 régions métropolitaines</h2>
        <p class="muted">Les nouvelles v0.1 ont un périmètre volontairement borné : blocs nationaux RX et relais FM 2 m revus.</p>
      </div>
      <div class="metro-grid">
        {metroPacks.map((pack) => {
          const variant = pack.variants.find((item) => item.id === pack.defaultVariant) ?? pack.variants[0];
          return (
            <button type="button" class="metro-pack pack-shortcut" data-pack-shortcut={pack.id}>
              <span>{pack.name}</span><strong>{variant?.memoryCount ?? 0} MEM</strong>
            </button>
          );
        })}
      </div>
    </div>
  </section>

  <script define:vars={{ publicPacks, defaultPublicPackId }}>
    const packSelect = document.querySelector("#pack-select");
    const packBadge = document.querySelector("#pack-badge");
    const packStatus = document.querySelector("#pack-status");
    const packDescription = document.querySelector("#pack-description");
    const aviationFieldset = document.querySelector("#aviation-fieldset");
    const aviation = document.querySelector("#include-aviation");
    const notamFieldset = document.querySelector("#notam-fieldset");
    const notam = document.querySelector("#notam-check");
    const confirmed = document.querySelector("#notam-confirmed");
    const confirmZone = document.querySelector("#notam-confirm-zone");
    const memoryCount = document.querySelector("#memory-count");
    const packSummary = document.querySelector("#pack-summary");
    const aviationSummary = document.querySelector("#aviation-summary");
    const notamSummary = document.querySelector("#notam-summary");
    const notamWarning = document.querySelector("#notam-warning");
    const fileSummary = document.querySelector("#file-summary");
    const variantNote = document.querySelector("#variant-note");
    const downloadLink = document.querySelector("#download-csv");

    const findPack = () => {
      const selectedId = packSelect?.value || defaultPublicPackId;
      return publicPacks.find((pack) => pack.id === selectedId) || publicPacks[0];
    };

    const findVariant = (pack) => {
      let variantId = pack.defaultVariant;
      if (pack.aviationToggle && aviation) {
        variantId = aviation.checked
          ? pack.aviationToggle.includedVariant
          : pack.aviationToggle.excludedVariant;
      }
      return pack.variants.find((variant) => variant.id === variantId) || pack.variants[0];
    };

    const resetUnsupportedControls = (pack) => {
      const aviationSupported = Boolean(pack.aviationToggle);
      if (aviationFieldset) aviationFieldset.hidden = !aviationSupported;
      if (aviation) aviation.disabled = !aviationSupported;

      if (notamFieldset) notamFieldset.hidden = !pack.notamCheck;
      if (notam) {
        notam.disabled = !pack.notamCheck;
        if (!pack.notamCheck) notam.checked = false;
      }
      if (confirmed && !pack.notamCheck) confirmed.checked = false;
    };

    const renderSummary = () => {
      const pack = findPack();
      if (!pack || !downloadLink || !memoryCount || !fileSummary || !packSummary || !aviationSummary || !notamSummary || !notamWarning || !confirmZone || !confirmed) return;
      resetUnsupportedControls(pack);
      const variant = findVariant(pack);
      if (!variant) return;

      if (packBadge) packBadge.textContent = `${pack.name} ${pack.version}`;
      if (packStatus) packStatus.textContent = pack.status;
      if (packDescription) packDescription.textContent = pack.description;
      packSummary.textContent = `${pack.name} ${pack.version}`;
      memoryCount.textContent = String(variant.memoryCount);
      fileSummary.textContent = variant.filename;
      downloadLink.href = variant.downloadUrl;
      downloadLink.setAttribute("download", variant.filename);
      downloadLink.textContent = `Télécharger le CSV · ${variant.memoryCount} mémoires`;

      if (pack.aviationToggle) {
        aviationSummary.textContent = variant.aviationIncluded ? `Incluse · ${pack.aviationToggle.memoryCount}` : "Exclue · 0";
        if (variantNote) variantNote.textContent = "Pour Annecy, retirer l'aviation conserve les emplacements mémoire des autres blocs.";
      } else {
        aviationSummary.textContent = variant.aviationIncluded ? "Incluse · variante fixe" : "Configuration fixe";
        if (variantNote) variantNote.textContent = variant.aviationIncluded
          ? "Ce pack public fixe inclut son bloc aviation validé."
          : "Ce pack est proposé dans sa variante publique fixe déjà validée.";
      }

      const notamActive = Boolean(pack.notamCheck && notam?.checked);
      confirmZone.hidden = !notamActive;
      confirmed.disabled = !notamActive;

      if (!pack.notamCheck) {
        notamSummary.textContent = "Non proposé";
        notamWarning.textContent = "Ce pack utilise sa configuration publique fixe. Aucun contrôle NOTAM interactif n'est associé à cette variante.";
        return;
      }
      if (!notamActive) {
        notamSummary.textContent = "Non demandé";
        notamWarning.textContent = "Contrôle NOTAM non demandé. Les fréquences restent celles des sources officielles validées.";
        return;
      }
      if (confirmed.checked) {
        notamSummary.textContent = "Confirmé";
        notamWarning.textContent = "Contrôle NOTAM confirmé. Le fichier téléchargé reste la variante publique validée, sans modification automatique des fréquences.";
      } else {
        notamSummary.textContent = "Demandé · non confirmé";
        notamWarning.textContent = "Contrôle NOTAM demandé mais non confirmé. Cette vérification reste facultative et non bloquante.";
      }
    };

    packSelect?.addEventListener("change", renderSummary);
    aviation?.addEventListener("change", renderSummary);
    notam?.addEventListener("change", () => {
      if (confirmed && notam && !notam.checked) confirmed.checked = false;
      renderSummary();
    });
    confirmed?.addEventListener("change", renderSummary);
    renderSummary();
  </script>
  <script src="../scripts/generator-pack-shortcuts.js"></script>
</BaseLayout>

<style>
  .generator-hero{padding-bottom:48px}.hero-grid{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(280px,.55fr);gap:28px;align-items:end}.hero-copy{display:grid;gap:24px}.notice{display:grid;gap:6px;max-width:760px;padding:18px 20px;border-left:4px solid var(--green)}.notice p,.status-card>p{color:var(--muted)}.status-card{display:grid;gap:14px;padding:24px}.status-card>strong{font-size:1.3rem}.status-card dl{display:grid;gap:7px;margin:0}.status-card dl div{display:flex;justify-content:space-between;gap:15px;padding-top:7px;border-top:1px solid var(--line)}.status-card dt{color:var(--muted)}.status-card dd{margin:0;font-weight:900}.generator-grid{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(300px,.8fr);gap:20px;align-items:start}.generator-form,.summary-card{padding:26px}.form-heading{display:flex;justify-content:space-between;gap:18px;align-items:start;margin-bottom:22px}.form-heading h2{margin-top:12px}.generator-form fieldset{display:grid;gap:12px;margin:0;padding:20px 0;border:0;border-top:1px solid var(--line)}.generator-form legend{padding:0 0 10px;font-weight:900}.select-label{font-size:.78rem;color:var(--muted)}.generator-form select{width:100%;padding:12px;border:1px solid var(--line);border-radius:10px;background:#1d2c41;color:var(--text)}.option-row{display:flex;justify-content:space-between;gap:18px;padding:14px;border:1px solid var(--line);border-radius:12px}.option-row span{display:grid;gap:4px}.option-row small{color:var(--muted)}.option-row input{width:20px}.notam-confirm{display:grid;gap:12px;padding:15px;border:1px solid var(--line);border-radius:12px}.notam-links{display:flex;flex-wrap:wrap;gap:8px}.notam-links a{padding:8px 10px;border:1px solid var(--line);border-radius:8px}.notam-confirm-check{display:flex;gap:9px}.form-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:22px}.summary-card{position:sticky;top:108px}.memory-counter{display:flex;align-items:end;gap:10px;margin:25px 0}.memory-counter strong{font-size:4.4rem;line-height:.8;letter-spacing:-.07em}.memory-counter span{color:var(--muted)}.summary-list{display:grid;gap:0}.summary-list>div{display:flex;justify-content:space-between;gap:18px;padding:11px 0;border-top:1px solid var(--line)}.summary-list span{color:var(--muted)}.summary-list strong{text-align:right}.summary-warning{margin-top:18px;padding:13px;border-radius:10px;background:rgba(244,201,93,.11)}.summary-note{margin-top:14px}.pack-shortcuts-section{padding-bottom:90px}.shortcut-heading{display:grid;gap:10px;margin-bottom:24px}.info-card{display:grid;gap:12px;padding:21px;cursor:pointer}.info-card small{font-size:.72rem;color:var(--muted)}.shortcut-action{margin-top:auto;color:var(--blue);font-weight:900;font-size:.75rem}.metro-heading{display:grid;gap:7px;margin:42px 0 18px}.metro-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.metro-pack{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 14px;border:1px solid var(--line);border-radius:11px;background:rgba(43,61,86,.6);color:var(--text);cursor:pointer;text-align:left}.metro-pack:hover{border-color:rgba(78,168,255,.35);transform:translateY(-1px)}.metro-pack strong{color:var(--green);font-size:.68rem;white-space:nowrap}@media(max-width:900px){.hero-grid,.generator-grid{grid-template-columns:1fr}.summary-card{position:static}.metro-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:600px){.generator-form,.summary-card{padding:19px}.form-heading{flex-direction:column}.metro-grid{grid-template-columns:1fr}.summary-list>div{align-items:start;flex-direction:column}.summary-list strong{text-align:left}}
</style>
