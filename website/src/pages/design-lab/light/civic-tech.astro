---
import LightDesignLabLayout from "../../../layouts/LightDesignLabLayout.astro";
import { publicPacks } from "../../../lib/packRegistry";
const order = ["normandie", "annecy-alpes-leman", "bretagne"];
const packs = order.map((id) => publicPacks.find((pack) => pack.id === id)).filter(Boolean).map((pack: any) => ({ ...pack, count: pack.variants.find((v: any) => v.id === pack.defaultVariant)?.memoryCount ?? pack.variants[0]?.memoryCount ?? 0 }));
---
<LightDesignLabLayout title="Civic Tech" description="Concept clair Civic Tech pour RadioPack France." concept="civic-tech" themeColor="#ffffff">
  <div class="civic">
    <section class="top"><div class="wrap breadcrumbs">Accueil <span>›</span> Packs régionaux</div></section>
    <section class="hero wrap"><div><span class="tag">RADIOPACK FRANCE</span><h1>Des fichiers radio publics,<br />vérifiés et faciles à utiliser.</h1><p>Choisis une région, vérifie la version publiée et récupère un codeplug CHIRP en réception seule.</p><div class="actions"><a href="/regions">Voir les régions</a><a class="secondary" href="/documentation">Comprendre le projet</a></div></div><aside><b>Principes de publication</b><ul><li>Sources publiques vérifiables</li><li>Réception seule</li><li>Versions publiques immuables</li><li>Pas de données opérationnelles privées</li></ul></aside></section>
    <section class="catalog"><div class="wrap"><div class="catalog-head"><div><span>CATALOGUE PUBLIC</span><h2>Packs régionaux disponibles</h2></div><small>Mise à disposition gratuite</small></div><div class="table"><div class="thead"><span>Région</span><span>Version</span><span>Statut</span><span>Mémoires</span><span></span></div>{packs.map((pack:any)=><a class="tr" href={`/regions/${pack.regionSlug}`}><strong>{pack.name}</strong><span>{pack.version}</span><span><i></i> Public RX</span><b>{pack.count}</b><em>Consulter →</em></a>)}</div></div></section>
    <section class="trust wrap"><div class="flag"><i></i><i></i><i></i></div><div><span>MÉTHODE</span><h2>La confiance vient de la traçabilité.</h2></div><p>Chaque pack est relié à une version, des règles de publication et un historique. L’interface met cette fiabilité au premier plan plutôt que de la cacher derrière des effets visuels.</p></section>
  </div>
</LightDesignLabLayout>
<style>
  .civic{min-height:100vh;background:white;color:#091e42;font-family:Arial,Helvetica,sans-serif}.wrap{width:min(1160px,calc(100% - 36px));margin:auto}.top{border-bottom:1px solid #e0e4eb;background:#f7f8fa}.breadcrumbs{padding:12px 0;color:#66748a;font-size:.72rem}.breadcrumbs span{margin:0 7px}.hero{display:grid;grid-template-columns:1.55fr .65fr;gap:70px;padding:76px 0 72px}.tag,.catalog-head span,.trust span{color:#1565c0;font-size:.7rem;font-weight:900;letter-spacing:.13em}.hero h1{margin:18px 0 22px;max-width:860px;font-size:clamp(3rem,6.6vw,6.2rem);line-height:.98;letter-spacing:-.055em}.hero p{max-width:690px;color:#52637c;font-size:1.08rem;line-height:1.7}.actions{display:flex;gap:10px;margin-top:30px}.actions a{padding:13px 17px;background:#1565c0;color:white;font-size:.82rem;font-weight:850;border-radius:4px}.actions .secondary{background:white;color:#12335d;border:1px solid #aebbd0}.hero aside{align-self:end;padding:25px;border-left:4px solid #e53e3e;background:#f7f9fc}.hero aside b{font-size:.88rem}.hero aside ul{margin:18px 0 0;padding-left:18px;color:#53647b;font-size:.84rem;line-height:1.8}.catalog{padding:56px 0 76px;background:#f5f7fa;border-top:1px solid #e1e6ed;border-bottom:1px solid #e1e6ed}.catalog-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:24px}.catalog-head h2{margin:10px 0 0;font-size:2.25rem;letter-spacing:-.035em}.catalog-head small{color:#6c788b}.table{border:1px solid #dce2ea;background:white}.thead,.tr{display:grid;grid-template-columns:1.7fr 120px 150px 120px 130px;gap:16px;align-items:center;padding:0 18px}.thead{min-height:46px;background:#091e42;color:white;font-size:.67rem;font-weight:850;letter-spacing:.07em}.tr{min-height:82px;border-top:1px solid #e5e9ef}.tr:first-of-type{border-top:0}.tr>strong{font-size:1.06rem}.tr span{font-size:.79rem;color:#52637a}.tr span:nth-child(3){display:flex;align-items:center;gap:7px}.tr i{width:8px;height:8px;border-radius:50%;background:#218739}.tr b{text-align:right;font-size:1.4rem}.tr em{font-style:normal;color:#1565c0;font-size:.76rem;font-weight:850;text-align:right}.trust{display:grid;grid-template-columns:85px .9fr 1fr;gap:35px;align-items:start;padding:72px 0 96px}.flag{display:flex;width:66px;height:42px}.flag i{flex:1}.flag i:nth-child(1){background:#153c8c}.flag i:nth-child(2){background:white;border-block:1px solid #e2e5e9}.flag i:nth-child(3){background:#e53e3e}.trust h2{margin:10px 0 0;font-size:2.6rem;letter-spacing:-.04em}.trust p{margin:0;color:#56677d;line-height:1.7}@media(max-width:820px){.hero,.trust{grid-template-columns:1fr}.thead{display:none}.tr{grid-template-columns:1fr 80px 70px}.tr span:nth-of-type(2),.tr em{display:none}.catalog-head{align-items:start;flex-direction:column;gap:10px}}
</style>
