---
import LightDesignLabLayout from "../../../layouts/LightDesignLabLayout.astro";
import { publicPacks } from "../../../lib/packRegistry";
const order = ["normandie", "annecy-alpes-leman", "bretagne"];
const packs = order.map((id) => publicPacks.find((pack) => pack.id === id)).filter(Boolean).map((pack: any) => ({ ...pack, count: pack.variants.find((v: any) => v.id === pack.defaultVariant)?.memoryCount ?? pack.variants[0]?.memoryCount ?? 0 }));
---
<LightDesignLabLayout title="Soft Spectrum" description="Concept clair Soft Spectrum pour RadioPack France." concept="soft-spectrum" themeColor="#f8faff">
  <div class="soft">
    <section class="hero wrap"><span class="pill">● PACKS PUBLICS · RX ONLY</span><h1>Ta radio, organisée<br /><em>sans complication.</em></h1><p>Des codeplugs régionaux propres, sourcés et prêts à importer. Une interface plus douce qui garde les informations techniques simples à parcourir.</p><div class="actions"><a href="/regions">Choisir une région</a><a class="ghost" href="/generateur">Créer mon pack</a></div><div class="orb a"></div><div class="orb b"></div></section>
    <section class="packs wrap"><div class="heading"><span>Packs populaires</span><a href="/regions">Toutes les régions →</a></div><div class="cards">{packs.map((pack:any,i)=><a class={`card c${i+1}`} href={`/regions/${pack.regionSlug}`}><div class="top"><span>0{i+1}</span><small>{pack.version}</small></div><h2>{pack.name}</h2><p>Version publique · réception seule</p><div class="bottom"><strong>{pack.count}</strong><span>mémoires</span><i>↗</i></div></a>)}</div></section>
    <section class="benefits wrap"><div><span>✓</span><h3>Sourcé</h3><p>Chaque ajout suit une provenance publique vérifiable.</p></div><div><span>✓</span><h3>Sans émission</h3><p>Les fichiers publics restent strictement en réception.</p></div><div><span>✓</span><h3>Versionné</h3><p>Les publications restent figées et identifiables.</p></div></section>
  </div>
</LightDesignLabLayout>
<style>
  .soft{min-height:100vh;background:linear-gradient(180deg,#fbfcff 0%,#f4f7ff 55%,#fff 100%);color:#182033}.wrap{width:min(1140px,calc(100% - 36px));margin:auto}.hero{position:relative;overflow:hidden;padding:100px 0 110px}.pill{display:inline-flex;padding:8px 12px;border:1px solid #d8e3ff;border-radius:999px;background:rgba(255,255,255,.7);color:#3a6fe8;font-size:.72rem;font-weight:900;letter-spacing:.08em}.hero h1{position:relative;z-index:2;margin:28px 0 22px;max-width:920px;font-size:clamp(3.6rem,8vw,7rem);line-height:.95;letter-spacing:-.065em}.hero h1 em{font-style:normal;color:#7b68ee}.hero p{position:relative;z-index:2;max-width:690px;color:#67748c;font-size:1.12rem;line-height:1.7}.actions{position:relative;z-index:2;display:flex;gap:10px;margin-top:32px}.actions a{padding:14px 19px;border-radius:14px;background:#315efb;color:white;font-weight:850;box-shadow:0 10px 26px rgba(49,94,251,.18)}.actions a.ghost{background:white;color:#354056;border:1px solid #dfe5f1;box-shadow:none}.orb{position:absolute;border-radius:50%;filter:blur(3px);opacity:.65}.orb.a{width:350px;height:350px;right:3%;top:45px;background:radial-gradient(circle at 30% 30%,#fff,#c8dfff 45%,#cbbcff)}.orb.b{width:170px;height:170px;right:29%;bottom:20px;background:radial-gradient(circle,#d9fff7,#a9e7ff)}.packs{padding:20px 0 78px}.heading{display:flex;justify-content:space-between;align-items:center;margin-bottom:22px}.heading span{font-size:1.2rem;font-weight:900}.heading a{color:#5670aa;font-size:.8rem;font-weight:800}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.card{min-height:330px;padding:26px;border:1px solid rgba(65,83,120,.12);border-radius:28px;background:rgba(255,255,255,.76);box-shadow:0 18px 55px rgba(52,71,112,.08);backdrop-filter:blur(18px)}.c1{background:linear-gradient(145deg,#fff,#eef6ff)}.c2{background:linear-gradient(145deg,#fff,#f5efff)}.c3{background:linear-gradient(145deg,#fff,#effcf8)}.top{display:flex;justify-content:space-between}.top>span{display:grid;place-items:center;width:42px;height:42px;border-radius:14px;background:#182033;color:white;font-weight:900}.top small{color:#75829a;font-weight:800}.card h2{margin:52px 0 10px;font-size:clamp(1.8rem,3vw,2.8rem);letter-spacing:-.045em}.card p{color:#7a8699}.bottom{display:grid;grid-template-columns:auto 1fr auto;gap:8px;align-items:end;margin-top:50px}.bottom strong{font-size:2.7rem;line-height:1}.bottom span{color:#748198;font-size:.75rem}.bottom i{font-style:normal;font-size:1.5rem;color:#6e65dd}.benefits{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;padding:0 0 96px}.benefits>div{padding:24px;border-top:1px solid #dfe5ef}.benefits span{color:#315efb;font-weight:900}.benefits h3{margin:16px 0 8px;font-size:1.1rem}.benefits p{margin:0;color:#758198;line-height:1.55}@media(max-width:780px){.orb{opacity:.35}.cards,.benefits{grid-template-columns:1fr}.hero{padding-top:72px}}
</style>
