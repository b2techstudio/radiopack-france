---
import BaseLayout from "../layouts/BaseLayout.astro";
import { publicPacks } from "../lib/packRegistry";

const packs = publicPacks;
const metropolitanCount = packs.filter((pack) => pack.id !== "annecy-alpes-leman").length;

const modules = [
  ["PMR446 analogique", "16", "v0.1.0"],
  ["VHF marine", "90", "v0.2.0"],
  ["APRS & ISS", "6", "v0.2.1"],
  ["Appels radioamateur", "2", "v0.3.0"],
];
---

<BaseLayout
  title="État des packs"
  description="Versions publiques, disponibilité, variantes et nombre de mémoires des packs RadioPack France."
  themeColor="#182538"
  colorScheme="dark"
>
  <section class="section versions-page">
    <div class="container">
      <span class="eyebrow">Suivi des publications</span>
      <div class="page-head">
        <div>
          <h1>État des packs</h1>
          <p class="coverage"><strong>{metropolitanCount}/13</strong> régions administratives métropolitaines couvertes · {packs.length} packs publics avec Annecy–Alpes–Léman.</p>
        </div>
        <p class="lead">Cette vue est construite directement depuis le registre public. Tous les exports présentés restent en réception seule.</p>
      </div>

      <div class="pack-list">
        {packs.map((pack, index) => {
          const defaultVariant = pack.variants.find((variant) => variant.id === pack.defaultVariant) ?? pack.variants[0];
          return (
            <article class="pack-card card">
              <div class="bank">B{String(index + 1).padStart(2, "0")}</div>
              <div class="pack-copy">
                <div class="topline"><span class="badge badge-green">{pack.status}</span><strong>{pack.version}</strong></div>
                <h2>{pack.name}</h2>
                <p>{pack.description}</p>
                <div class="variant-list">
                  {pack.variants.map((variant) => (
                    <div class="variant">
                      <span>{variant.label}</span>
                      <strong>{variant.memoryCount} mémoires</strong>
                      <a href={variant.downloadUrl} download={variant.filename}>CSV →</a>
                    </div>
                  ))}
                </div>
                <div class="button-row">
                  <a class="button button-secondary" href={`/regions/${pack.regionSlug}`}>Voir le pack</a>
                  {defaultVariant && <a class="button button-primary" href={defaultVariant.downloadUrl} download={defaultVariant.filename}>Télécharger la variante par défaut</a>}
                </div>
              </div>
              <div class="memory-count"><strong>{defaultVariant?.memoryCount ?? 0}</strong><span>MEM RX</span></div>
            </article>
          );
        })}
      </div>

      <section class="modules card">
        <div>
          <span class="eyebrow">Modules nationaux</span>
          <h2>Blocs réutilisés dans les packs</h2>
          <p>Les nouvelles v0.1 métropolitaines utilisent PMR446, appels radioamateur et APRS/ISS, complétés par une sélection régionale de relais FM 2 m. La VHF marine reste disponible séparément.</p>
        </div>
        <div class="module-list">
          {modules.map(([name, count, version]) => (
            <div><strong>{name}</strong><span>{count} mémoires</span><small>{version}</small></div>
          ))}
        </div>
      </section>

      <div class="card policy">
        <span class="policy-light"></span>
        <div><strong>Règle permanente du projet public</strong><p>Les CSV publiés par RadioPack France restent configurés en réception seule. L'ajout d'une fréquence ne constitue jamais une autorisation d'émettre.</p></div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .versions-page { padding-top: 72px; }
  .page-head { display: grid; grid-template-columns: 1fr .7fr; gap: 34px; align-items: end; margin: 18px 0 54px; }
  .page-head h1 { font-size: clamp(3.4rem, 8vw, 6.2rem); }
  .page-head .lead { max-width: 620px; }
  .coverage { margin-top: 16px; color: var(--muted); }
  .coverage strong { color: var(--green); font-family: "Space Grotesk", sans-serif; font-size: 1.35rem; }
  .pack-list { display: grid; gap: 16px; }
  .pack-card { display: grid; grid-template-columns: 70px 1fr 150px; gap: 24px; padding: 28px; background: linear-gradient(145deg, rgba(43,61,86,.96), rgba(34,50,73,.91)); }
  .bank { color: var(--blue); font: 900 1rem "SFMono-Regular", Consolas, monospace; }
  .pack-copy { display: grid; gap: 16px; }
  .topline { display: flex; align-items: center; gap: 12px; }
  .topline > strong { color: var(--blue); font: 900 .8rem "SFMono-Regular", Consolas, monospace; letter-spacing: .08em; }
  .pack-copy h2 { font-size: clamp(2rem, 4vw, 3.2rem); }
  .pack-copy > p { color: var(--muted); max-width: 760px; }
  .memory-count { display: grid; align-content: start; justify-items: end; }
  .memory-count strong { font-family: "Space Grotesk", sans-serif; font-size: 3.7rem; line-height: .86; letter-spacing: -.07em; }
  .memory-count span { margin-top: 8px; color: var(--orange); font: 900 .67rem "SFMono-Regular", Consolas, monospace; letter-spacing: .1em; }
  .variant-list { display: grid; border-top: 1px solid var(--line); }
  .variant { display: grid; grid-template-columns: 1fr auto 54px; gap: 18px; align-items: center; padding: 11px 0; border-bottom: 1px solid var(--line); }
  .variant span { color: var(--muted); }
  .variant strong { font-size: .84rem; }
  .variant a { color: var(--blue); font-size: .76rem; font-weight: 900; text-align: right; }
  .modules { display: grid; grid-template-columns: .9fr 1.1fr; gap: 30px; margin-top: 56px; padding: 28px; }
  .modules h2 { margin: 12px 0; }
  .modules p { color: var(--muted); }
  .module-list { display: grid; gap: 9px; }
  .module-list > div { display: grid; grid-template-columns: 1fr auto auto; gap: 14px; align-items: center; padding: 12px 14px; border: 1px solid var(--line); border-radius: 12px; }
  .module-list span, .module-list small { color: var(--muted); }
  .policy { display: grid; grid-template-columns: 12px 1fr; gap: 16px; align-items: start; margin-top: 22px; padding: 22px; }
  .policy-light { width: 9px; height: 9px; margin-top: 7px; border-radius: 50%; background: var(--green); box-shadow: 0 0 18px rgba(101,215,177,.42); }
  .policy p { margin-top: 6px; color: var(--muted); }
  @media (max-width: 800px) {
    .page-head, .pack-card, .modules { grid-template-columns: 1fr; }
    .memory-count { justify-items: start; }
  }
  @media (max-width: 560px) {
    .variant { grid-template-columns: 1fr auto; }
    .variant a { grid-column: 1 / -1; text-align: left; }
    .module-list > div { grid-template-columns: 1fr auto; }
    .module-list small { grid-column: 1 / -1; }
  }
</style>
