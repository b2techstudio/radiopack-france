---
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout title="Annecy & Haute-Savoie — RadioPack France">
  <section class="section"><div class="container page-grid"><div class="copy"><span class="eyebrow">Deuxième pack prévu</span><h1>Annecy &<br/><span class="gradient-text">Haute-Savoie</span></h1><p class="lead">Une future sélection adaptée aux Alpes du Nord, à Annecy et aux zones proches, après validation complète du pack Normandie.</p></div><aside class="card status-card"><span class="badge">Planifié</span><h3>Contenu envisagé</h3><p class="muted">PMR446, relais radioamateurs régionaux, aviation publique, APRS et ISS.</p></aside></div></section>
</BaseLayout>
<style>.page-grid{display:grid;grid-template-columns:1.25fr .75fr;gap:30px}.copy{display:grid;gap:22px}.copy h1{font-size:clamp(3.4rem,7vw,5.8rem)}.status-card{padding:28px}.status-card h3{margin:18px 0 10px}@media(max-width:800px){.page-grid{grid-template-columns:1fr}}</style>
