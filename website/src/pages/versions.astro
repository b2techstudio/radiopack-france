---
import BaseLayout from "../layouts/BaseLayout.astro";

const packs = [
  {
    name: "Normandie",
    version: "0.3.1",
    memories: 139,
    verified: "4 août 2026",
    href: "/regions/normandie",
    download: "/downloads/normandie/radiopack-france-normandie-v0.3.1.csv",
    tone: "purple",
    details: "PMR446, VHF marine, APRS/ISS, aviation, appels et 15 sorties analogiques.",
  },
  {
    name: "Annecy & Haute-Savoie",
    version: "0.1.0",
    memories: 36,
    verified: "4 août 2026",
    href: "/regions/annecy-haute-savoie",
    download: "/downloads/annecy-haute-savoie/radiopack-france-annecy-haute-savoie-v0.1.csv",
    tone: "cyan",
    details: "PMR446, APRS/ISS, aviation, appels et 9 sorties analogiques uniques.",
  },
];

const modules = [
  ["PMR446 analogique", "16", "v0.1.0"],
  ["VHF marine", "90", "v0.2.0"],
  ["APRS & ISS", "6", "v0.2.0"],
  ["Appels radioamateur", "2", "v0.3.0"],
];
---
<BaseLayout
  title="État des packs"
  description="Versions, nombre de mémoires et dates de vérification des packs RadioPack France."
>
  <section class="section">
    <div class="container">
      <span class="eyebrow">Suivi des publications</span>
      <h1>État des packs</h1>
      <p class="lead intro">
        Cette page indique les versions actuellement publiées, leur nombre de mémoires
        et la dernière date de vérification affichée dans le projet.
      </p>

      <div class="grid-2 pack-grid">
        {
          packs.map((pack) => (
            <article class:list={["pack-card", "card", pack.tone]}>
              <div class="topline">
                <span class="badge badge-green">Disponible</span>
                <strong>v{pack.version}</strong>
              </div>
              <h2>{pack.name}</h2>
              <div class="memory-count">
                <strong>{pack.memories}</strong>
                <span>mémoires RX sur 200</span>
              </div>
              <p>{pack.details}</p>
              <dl>
                <div>
                  <dt>Dernière vérification</dt>
                  <dd>{pack.verified}</dd>
                </div>
                <div>
                  <dt>Politique publique</dt>
                  <dd>Duplex=off</dd>
                </div>
              </dl>
              <div class="button-row">
                <a class="button button-secondary" href={pack.href}>Voir le pack</a>
                <a class="button button-primary" href={pack.download} download>Télécharger le CSV</a>
              </div>
            </article>
          ))
        }
      </div>

      <section class="modules card">
        <div>
          <span class="eyebrow">Modules nationaux</span>
          <h2>Fichiers réutilisés dans les packs</h2>
          <p>
            Ces blocs sont générés séparément puis placés dans les packs régionaux
            selon leur organisation de mémoires.
          </p>
        </div>
        <div class="module-list">
          {
            modules.map(([name, count, version]) => (
              <div>
                <strong>{name}</strong>
                <span>{count} mémoires</span>
                <small>{version}</small>
              </div>
            ))
          }
        </div>
      </section>

      <div class="card policy">
        <strong>Règle permanente du projet public</strong>
        <p>
          Les CSV publiés par RadioPack France restent configurés en réception seule.
          L'ajout d'une fréquence ne constitue jamais une autorisation d'émettre.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  h1 {
    margin: 18px 0;
    font-size: clamp(3rem, 7vw, 5.4rem);
  }

  .intro {
    max-width: 850px;
  }

  .pack-grid {
    margin-top: 34px;
  }

  .pack-card {
    display: grid;
    gap: 18px;
    padding: 28px;
    overflow: hidden;
  }

  .pack-card.purple {
    background: linear-gradient(145deg, rgba(255,255,255,.94), rgba(242,231,255,.74));
  }

  .pack-card.cyan {
    background: linear-gradient(145deg, rgba(255,255,255,.94), rgba(221,249,252,.82));
  }

  .topline {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 14px;
  }

  .topline > strong {
    color: #5f31cf;
    font-family: "Space Grotesk", sans-serif;
  }

  .memory-count {
    display: flex;
    align-items: end;
    gap: 10px;
  }

  .memory-count strong {
    font-family: "Space Grotesk", sans-serif;
    font-size: 3.2rem;
    line-height: .9;
    color: #182230;
  }

  .memory-count span,
  .pack-card p,
  .modules p,
  .policy p {
    color: var(--muted);
  }

  dl {
    display: grid;
    gap: 8px;
    margin: 0;
  }

  dl > div {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding: 10px 0;
    border-bottom: 1px solid var(--line);
  }

  dt {
    color: var(--muted);
  }

  dd {
    margin: 0;
    font-weight: 800;
  }

  .modules {
    display: grid;
    grid-template-columns: .9fr 1.1fr;
    gap: 30px;
    margin-top: 30px;
    padding: 28px;
  }

  .modules h2 {
    margin: 10px 0;
  }

  .module-list {
    display: grid;
    gap: 9px;
  }

  .module-list > div {
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: 14px;
    align-items: center;
    padding: 12px 14px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: rgba(255,255,255,.7);
  }

  .module-list span,
  .module-list small {
    color: var(--muted);
  }

  .policy {
    margin-top: 30px;
    padding: 22px;
    background: linear-gradient(120deg, rgba(240,154,32,.13), rgba(255,255,255,.82));
  }

  .policy p {
    margin-top: 6px;
  }

  @media (max-width: 760px) {
    .modules {
      grid-template-columns: 1fr;
    }

    .module-list > div {
      grid-template-columns: 1fr auto;
    }

    .module-list small {
      grid-column: 1 / -1;
    }
  }
</style>
