---
const currentPath = Astro.url.pathname;
const links = [
  ["/", "Accueil"],
  ["/regions", "Régions"],
  ["/generateur", "Générateur"],
  ["/telechargements", "Téléchargements"],
  ["/documentation", "Documentation"],
  ["/a-propos", "À propos"],
];

const isActive = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);
---
<header class="site-header">
  <div class="container nav-shell">
    <a class="brand" href="/" aria-label="RadioPack France — Accueil">
      <img src="/brand/b2tech-logo.png" alt="Logo B2Tech Studio" />
      <span>
        <strong>RadioPack</strong>
        <small>France · B2Tech Studio</small>
      </span>
    </a>

    <nav class="desktop-nav" aria-label="Navigation principale">
      {
        links.map(([href, label]) => (
          <a
            class:list={[isActive(href) && "active"]}
            href={href}
            aria-current={isActive(href) ? "page" : undefined}
          >
            {label}
          </a>
        ))
      }
    </nav>

    <details class="mobile-menu">
      <summary aria-label="Ouvrir le menu de navigation">Menu</summary>
      <nav aria-label="Navigation mobile">
        {
          links.map(([href, label]) => (
            <a
              class:list={[isActive(href) && "active"]}
              href={href}
              aria-current={isActive(href) ? "page" : undefined}
            >
              {label}
            </a>
          ))
        }
        <a href="/versions">État des packs</a>
      </nav>
    </details>

    <a class="header-cta" href="/generateur">Générateur</a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    z-index: 20;
    top: 0;
    padding: 10px 0;
    background: rgba(5, 7, 11, .90);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid #182130;
  }

  .site-header::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;
    height: 1px;
    pointer-events: none;
    background: linear-gradient(90deg, transparent 0%, rgba(0,178,255,.45) 28%, rgba(145,70,255,.38) 64%, transparent 100%);
    opacity: .65;
  }

  .nav-shell {
    display: flex;
    align-items: center;
    gap: 24px;
    min-height: 62px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 11px;
    margin-right: auto;
  }

  .brand img {
    width: 46px;
    height: 46px;
    object-fit: contain;
    border-radius: 12px;
    box-shadow: 0 0 28px rgba(145,70,255,.14);
  }

  .brand span { display: grid; line-height: 1.05; }

  .brand strong {
    color: #f5f8fc;
    font-family: "Space Grotesk", sans-serif;
    font-size: 1.04rem;
    letter-spacing: -.025em;
  }

  .brand small {
    margin-top: 5px;
    color: #718096;
    font-size: .67rem;
    font-weight: 800;
    letter-spacing: .04em;
  }

  .desktop-nav { display: flex; align-items: center; gap: 3px; }

  nav a {
    padding: .62rem .72rem;
    border-radius: 999px;
    color: #8996a8;
    font-size: .78rem;
    font-weight: 800;
    transition: color .18s ease, background .18s ease;
  }

  nav a:hover,
  nav a.active {
    color: #eef5ff;
    background: rgba(0, 178, 255, .08);
  }

  nav a.active { box-shadow: inset 0 0 0 1px rgba(0,178,255,.14); }

  .header-cta {
    padding: .72rem .98rem;
    border: 1px solid #273347;
    border-radius: 999px;
    color: #f7f9fc;
    font-size: .76rem;
    font-weight: 900;
    background: linear-gradient(90deg, rgba(0,178,255,.14), rgba(145,70,255,.16));
    box-shadow: inset 0 0 0 1px rgba(255,255,255,.02);
  }

  .mobile-menu { display: none; position: relative; }

  .mobile-menu summary {
    padding: .66rem .8rem;
    border: 1px solid #273347;
    border-radius: 999px;
    color: #d9e3ef;
    background: #0b111b;
    cursor: pointer;
    font-size: .78rem;
    font-weight: 900;
    list-style: none;
  }

  .mobile-menu summary::-webkit-details-marker { display: none; }

  .mobile-menu nav {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    display: grid;
    min-width: 230px;
    padding: 10px;
    border: 1px solid #273347;
    border-radius: 18px;
    background: rgba(8, 12, 19, .98);
    box-shadow: 0 22px 55px rgba(0, 0, 0, .42);
  }

  @media (max-width: 940px) {
    .desktop-nav { display: none; }
    .mobile-menu { display: block; }
  }

  @media (max-width: 620px) {
    .nav-shell { gap: 9px; }
    .brand small { display: none; }
    .brand img { width: 42px; height: 42px; }
    .header-cta { padding-inline: .78rem; font-size: 0; }
    .header-cta::after { content: "CSV"; font-size: .75rem; }
  }
</style>
