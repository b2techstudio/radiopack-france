---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ChannelGroupDetails from "../../components/ChannelGroupDetails.astro";
import { buildStandardChannelGroups, type ChannelMemory } from "../../lib/channelDetails";
import { buildBfcV03Pack } from "../../lib/bfcPack";
import { buildCentreV03Pack } from "../../lib/centrePack";
import { getPublicPack } from "../../lib/packRegistry";
import {
  buildMetropolitanPack,
  metropolitanPackDefinitions,
  metropolitanSourceNotes,
  type MetropolitanPackDefinition,
} from "../../lib/metropolitanPack";

export function getStaticPaths() {
  return metropolitanPackDefinitions.map((pack) => ({
    params: { slug: pack.regionSlug },
    props: { pack },
  }));
}

const { pack } = Astro.props as { pack: MetropolitanPackDefinition };
const publicPack = getPublicPack(pack.id);
const publicVariant = publicPack?.variants.find((variant) => variant.id === publicPack.defaultVariant) ?? publicPack?.variants[0];
const isBfcV03 = pack.id === "bourgogne-franche-comte" && publicPack?.version === "v0.3";
const isCentreV03 = pack.id === "centre-val-de-loire" && publicPack?.version === "v0.3";
const isAdvancedV03 = isBfcV03 || isCentreV03;
const version = publicPack?.version ?? pack.version;
const placed = isBfcV03
  ? buildBfcV03Pack()
  : isCentreV03
    ? buildCentreV03Pack()
    : buildMetropolitanPack(pack.id, pack.version);
const memoryCount = placed.length;
if (publicVariant && publicVariant.memoryCount !== memoryCount) {
  throw new Error(`${pack.id}: registry=${publicVariant.memoryCount}, built=${memoryCount}`);
}
const memories: ChannelMemory[] = placed.map(({ location, channel }) => ({
  location,
  name: channel.name,
  frequency: channel.frequency_mhz.toFixed(6),
  mode: channel.mode,
  step: channel.step_khz.toFixed(2),
  comment: channel.comment,
}));
const channelGroups = buildStandardChannelGroups(memories);
const filename = publicVariant?.filename ?? pack.filename;
const downloadUrl = publicVariant?.downloadUrl ?? `/downloads/${pack.id}/${filename}`;
const aviationCount = placed.filter(({ channel }) => channel.mode === "AM").length;
const selectedInfrastructureCount = isBfcV03 ? pack.repeaters.length + 5 : isCentreV03 ? 10 : pack.repeaters.length;
const regionalChannelCount = isBfcV03 ? pack.repeaters.length * 2 + 10 : isCentreV03 ? 20 : pack.repeaters.length * 2;
const marineCount = pack.includeMarine ? 90 : 0;
const radioScopeLabel = isAdvancedV03
  ? "relais FM 2 m/70 cm et transpondeurs crossband analogiques"
  : "relais FM 2 m";
const radioRangeLabel = isBfcV03 ? "70+ / 80+" : isCentreV03 ? "70+ / 82+" : "70+";
const aviationRangeLabel = isBfcV03 ? "40+ / 90+" : "40+";
---
<BaseLayout
  title={`Pack ${pack.name} ${version} - RadioPack France`}
  description={`CSV CHIRP ${pack.name} ${version} de ${memoryCount} mémoires RX-only pour Quansheng UV-K5.`}
>
  <section class="section">
    <div class="container page-grid">
      <div class="copy">
        <span class="eyebrow">Pack régional enrichi · {version}</span>
        <h1>{pack.name}</h1>
        <p class="lead">
          Une version régionale enrichie sur le modèle des packs matures : socle national RX, aviation SIA
          revue dans le contexte AIRAC courant, sélection de {radioScopeLabel} en paired RX{pack.includeMarine ? ", et module VHF marine complet" : ""}.
          Le contenu reste borné aux données publiques suffisamment vérifiables et utiles à l'écoute.
        </p>
        <div class="button-row">
          <a class="button button-primary" href={downloadUrl} download={filename}>Télécharger le CSV {version}</a>
          <a class="button button-secondary" href="/documentation">Procédure CHIRP</a>
        </div>

        <div class="card legal">
          <strong>Réception seule sur les {memoryCount} mémoires</strong>
          <p>Toutes les lignes utilisent <code>Duplex=off</code> et <code>Offset=0.000000</code>. Les fréquences documentées n'accordent aucun droit d'émission.</p>
        </div>

        <div class="memory-map card">
          <h2>Périmètre {version}</h2>
          <div class="ranges">
            <span><b>0–15</b> PMR446 · 16</span>
            <span><b>20–21</b> Appels radioamateur · 2</span>
            <span><b>30–35</b> APRS / ISS · 6</span>
            <span><b>{aviationRangeLabel}</b> Aviation AM · {aviationCount}</span>
            <span><b>{radioRangeLabel}</b> {isAdvancedV03 ? "Relais / transpondeurs analogiques paired RX" : "Relais FM 2 m paired RX"} · {regionalChannelCount}</span>
            {pack.includeMarine && <span><b>100–189</b> VHF marine · {marineCount}</span>}
          </div>
          <p class="scope-note">
            Aviation : contexte SIA AIRAC 08/26 recoupé avec les pages eAIP publiques effectives ; aucune extraction XML champ par champ n'est revendiquée.
            {pack.includeMarine ? " Le littoral justifie l'intégration du module VHF marine national." : " Le module VHF marine reste séparé pour cette région intérieure."}
          </p>
          <p class="scope-note">{isAdvancedV03 ? "Les pistes radioamateur ou aviation encore ambiguës sont différées plutôt que publiées sans preuve suffisante." : "UHF, numérique et services privés restent hors publication tant qu'une revue dédiée n'a pas validé chaque fréquence et son intérêt d'écoute."}</p>
        </div>

        <ChannelGroupDetails
          groups={channelGroups}
          title={`Tous les canaux du pack ${pack.name}`}
          intro={`Chaque mémoire affichée ci-dessous correspond au CSV public ${version}. Les paires retenues restent représentées dans les deux sens uniquement en réception.`}
        />
      </div>

      <aside class="card status-card">
        <span class="badge badge-green">Disponible · {version}</span>
        <h3>{memoryCount} mémoires sur 200</h3>
        <div class="meter"><span style={`width:${Math.round((memoryCount / 200) * 100)}%`}></span></div>
        <ul>
          <li>RX-only</li>
          <li>{aviationCount} mémoires aviation AM</li>
          <li>{selectedInfrastructureCount} infrastructures analogiques sélectionnées</li>
          <li>paired RX : sortie + entrée vérifiée</li>
          {pack.includeMarine && <li>90 mémoires VHF marine</li>}
          <li>{isAdvancedV03 ? "v0.2 historique conservée" : "v0.1 historique conservée"}</li>
        </ul>
        <p class="source-note">Revue sources : {isCentreV03 ? "2026-08-20" : metropolitanSourceNotes.checkedOn}</p>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
.page-grid{display:grid;grid-template-columns:1.25fr .75fr;gap:30px;align-items:start}.copy{display:grid;gap:22px}.copy h1{font-size:clamp(3.3rem,7vw,6rem)}.status-card{padding:28px;position:sticky;top:110px}.status-card h3{margin:18px 0 10px}.status-card ul{margin:0;padding-left:1.2rem;color:var(--muted)}.meter{height:10px;border-radius:999px;background:rgba(255,255,255,.09);overflow:hidden;margin-bottom:18px}.meter span{display:block;height:100%;border-radius:inherit;background:linear-gradient(90deg,#65d7b1,#4ea8ff,#9185ff)}.legal,.memory-map{padding:22px}.legal p,.scope-note,.source-note{margin-top:8px;color:var(--muted)}code{font-weight:800;color:#b9b1ff}.ranges{display:flex;flex-wrap:wrap;gap:10px}.ranges span{padding:.55rem .7rem;border-radius:10px;border:1px solid var(--line);background:rgba(11,23,40,.28);color:var(--muted);font-size:.82rem}.ranges b{color:#9185ff;margin-right:4px}@media(max-width:800px){.page-grid{grid-template-columns:1fr}.status-card{position:static}}
</style>