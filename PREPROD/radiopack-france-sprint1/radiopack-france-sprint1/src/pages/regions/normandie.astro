---
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout title="Pack Normandie — RadioPack France" description="Pack CHIRP Normandie pour Quansheng UV-K5, en préparation.">
  <section class="section"><div class="container page-grid">
    <div class="copy"><span class="eyebrow">Pack prioritaire</span><h1>Normandie</h1><p class="lead">Le premier pack RadioPack France sera centré sur Mortain-Bocage, puis couvrira les zones voisines de la Manche, du Calvados, de l'Orne, de l'Ille-et-Vilaine et de la Mayenne.</p><div class="button-row"><a class="button button-primary" href="/documentation">Voir la méthode</a><a class="button button-secondary" href="https://github.com/b2techstudio/radiopack-france">Suivre sur GitHub</a></div></div>
    <aside class="card status-card"><span class="badge badge-orange">En préparation</span><h3>Objectif : 200 mémoires</h3><ul><li>16 canaux PMR446</li><li>Radioamateur 2 m / 70 cm</li><li>Relais locaux vérifiés</li><li>VHF marine utile</li><li>Aviation publique</li><li>APRS et ISS</li></ul></aside>
  </div></section>
</BaseLayout>
<style>.page-grid{display:grid;grid-template-columns:1.25fr .75fr;gap:30px;align-items:start}.copy{display:grid;gap:22px}.copy h1{font-size:clamp(3.8rem,8vw,6.4rem)}.status-card{padding:28px}.status-card h3{margin:18px 0}.status-card ul{margin:0;padding-left:1.2rem;color:var(--muted)}@media(max-width:800px){.page-grid{grid-template-columns:1fr}}</style>
