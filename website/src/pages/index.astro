---
import BaseLayout from "../layouts/BaseLayout.astro";
import { publicPacks } from "../lib/packRegistry";

const packs = publicPacks.map((pack) => ({
  ...pack,
  count:
    pack.variants.find((variant) => variant.id === pack.defaultVariant)?.memoryCount ??
    pack.variants[0]?.memoryCount ??
    0,
}));
const totalMemories = packs.reduce((sum, pack) => sum + pack.count, 0);
const metropolitanCount = packs.filter((pack) => pack.id !== "annecy-alpes-leman").length;
const newRegionCount = packs.filter((pack) => pack.version === "v0.1").length;
---

<BaseLayout
  title="RadioPack France — Codeplugs CHIRP régionaux"
  description="Les 13 régions métropolitaines disposent désormais d'un pack RadioPack France public en réception seule, complétées par Annecy–Alpes–Léman."
  themeColor="#182538"
  colorScheme="dark"
  bodyClass="home-midnight-blue"
>
  <div class="midnight-page">
    <section class="hero wrap">
      <div class="hero-copy">
        <span class="eyebrow">RADIOPACK FRANCE · B2TECH STUDIO</span>
        <h1>La radio,<br /><em>organisée.</em><br />Partout en France.</h1>
        <p>
          Les <strong>13 régions administratives métropolitaines</strong> ont maintenant leur pack public.
          Les nouvelles v0.1 privilégient un socle RX fiable et volontairement borné plutôt qu'une liste exhaustive,
          tandis qu'Annecy–Alpes–Léman reste disponible comme pack territorial spécialisé.
        </p>
        <div class="actions">
          <a class="primary" href="/regions">Voir les 13 régions</a>
          <a href="/generateur">Ouvrir le générateur</a>
        </div>
        <div class="status-line">
          <span><i></i> {metropolitanCount}/13 régions métropolitaines</span>
          <span>{packs.length} packs publics</span>
          <span>{totalMemories} mémoires RX cumulées</span>
        </div>
      </div>

      <div class="radio-orbit" aria-label="Visualisation radio moderne RadioPack France">
        <div class="ambient-grid" aria-hidden="true"></div>
        <div class="signal-ring ring-one" aria-hidden="true"></div>
        <div class="signal-ring ring-two" aria-hidden="true"></div>

        <div class="modern-console">
          <div class="console-head">
            <div class="console-brand">
              <span class="brand-dot"></span>
              <div><small>RADIOPACK</small><strong>FRANCE RX NETWORK</strong></div>
            </div>
            <span class="rx-pill"><i></i> RX ONLY</span>
          </div>

          <div class="coverage-display">
            <div class="coverage-ring">
              <span>COUVERTURE</span>
              <strong>{metropolitanCount}<small>/13</small></strong>
              <b>RÉGIONS</b>
            </div>
            <div class="coverage-stats">
              <div><small>PACKS PUBLICS</small><strong>{packs.length}</strong><span>+ Alpes–Léman</span></div>
              <div><small>NOUVELLES V0.1</small><strong>{newRegionCount}</strong><span>socles régionaux</span></div>
              <div><small>MÉMOIRES RX</small><strong>{totalMemories}</strong><span>variantes par défaut</span></div>
            </div>
          </div>

          <div class="spectrum-card" aria-hidden="true">
            <div class="spectrum-head"><span>RX SPECTRUM</span><b>FRANCE ONLINE</b></div>
            <div class="spectrum-bars">
              {Array.from({ length: 42 }).map((_, i) => (
                <i style={`--bar:${18 + ((i * 37) % 76)}%;--delay:${(i % 8) * -0.12}s`}></i>
              ))}
            </div>
            <div class="spectrum-line"></div>
          </div>

          <div class="console-foot">
            <span><i></i> PUBLIC DATA</span>
            <span>CHIRP</span>
            <span>VERSIONED</span>
          </div>
        </div>

        <div class="float-chip chip-left"><i></i> 13/13 READY</div>
        <div class="float-chip chip-right">{totalMemories} MEM</div>
      </div>
    </section>

    <section class="coverage-strip wrap" aria-label="Couverture RadioPack France">
      <div><small>COUVERTURE</small><b>{metropolitanCount}/13</b><span>régions métropolitaines</span></div>
      <div><small>PUBLIC PACKS</small><b>{packs.length}</b><span>avec Alpes–Léman</span></div>
      <div><small>NOUVEAUX SOCLES</small><b>{newRegionCount}</b><span>v0.1 publiées</span></div>
      <div class="status"><small>MODE PUBLIC</small><b>RX</b><span>Duplex=off</span></div>
    </section>

    <section class="packs wrap" aria-labelledby="packs-title">
      <div class="section-head">
        <span>MEMORY BANKS</span>
        <h2 id="packs-title">La métropole est<br /><em>couverte.</em></h2>
        <p>
          Normandie et Bretagne conservent leurs versions matures. Les onze autres régions administratives
          démarrent avec une v0.1 publique, traçable et volontairement non exhaustive.
        </p>
      </div>

      <div class="pack-grid">
        {packs.map((pack, index) => (
          <a class="pack" href={`/regions/${pack.regionSlug}`}>
            <div class="pack-top">
              <span class="bank">B{String(index + 1).padStart(2, "0")}</span>
              <small>{pack.version} · PUBLIC RX</small>
            </div>
            <h3>{pack.name}</h3>
            <p>{pack.description}</p>
            <div class="pack-bottom"><strong>{pack.count}<small> MEM</small></strong><i aria-hidden="true">→</i></div>
          </a>
        ))}
      </div>
    </section>

    <section class="principles wrap" aria-label="Principes RadioPack France">
      <article><span>01</span><h3>Sources recoupées</h3><p>Les nouvelles sélections régionales n'intègrent que des informations radio publiques documentées et revues.</p></article>
      <article><span>02</span><h3>Réception seule</h3><p>Toutes les mémoires des CSV publics sont distribuées avec la transmission désactivée.</p></article>
      <article><span>03</span><h3>Version plutôt que volume</h3><p>Une v0.1 peut être volontairement limitée : les extensions viendront dans de nouvelles versions après revue.</p></article>
    </section>

    <section class="cta wrap">
      <div>
        <small>RADIOPACK / GENERATOR</small>
        <h2>Choisis ta région.<br />Télécharge ton pack.</h2>
      </div>
      <a href="/generateur">Ouvrir le générateur <span>→</span></a>
    </section>
  </div>
</BaseLayout>

<style>
  .midnight-page {
    --bg: #182538;
    --surface: #223249;
    --card: #2b3d56;
    --text: #f4f7fb;
    --muted: #adbed1;
    --accent: #4ea8ff;
    --accent2: #9185ff;
    --rx: #65d7b1;
    --signal: #f4c95d;
    min-height: 100vh;
    overflow: hidden;
    background:
      radial-gradient(circle at 78% 4%, rgba(145,133,255,.13), transparent 32rem),
      radial-gradient(circle at 10% 31%, rgba(78,168,255,.10), transparent 28rem),
      var(--bg);
    color: var(--text);
  }

  .wrap { width: min(1180px, calc(100% - 36px)); margin-inline: auto; }
  .hero { display:grid; grid-template-columns:1fr 1fr; gap:clamp(38px,6vw,88px); align-items:center; min-height:720px; padding-block:76px; }
  .eyebrow,.section-head>span { color:var(--accent); font-size:.71rem; font-weight:950; letter-spacing:.19em; }
  .hero h1 { margin:19px 0 24px; font-size:clamp(4rem,7.6vw,7.4rem); line-height:.87; letter-spacing:-.07em; }
  .hero h1 em,.section-head h2 em { color:var(--accent2); font-style:normal; }
  .hero-copy>p { max-width:620px; color:var(--muted); font-size:1.08rem; line-height:1.72; }
  .hero-copy>p strong { color:#dbe8f6; }
  .actions { display:flex; flex-wrap:wrap; gap:10px; margin-top:30px; }
  .actions a { padding:13px 17px; border:1px solid rgba(244,247,251,.22); border-radius:10px; font-size:.83rem; font-weight:850; transition:.18s ease; }
  .actions a:hover { transform:translateY(-2px); border-color:rgba(244,247,251,.42); }
  .actions .primary { color:var(--bg); background:var(--text); border-color:var(--text); }
  .status-line { display:flex; flex-wrap:wrap; gap:20px; margin-top:31px; color:#8198b2; font-size:.72rem; font-weight:800; }
  .status-line span { display:flex; align-items:center; gap:7px; }
  .status-line i { width:7px; height:7px; border-radius:50%; background:var(--rx); box-shadow:0 0 14px rgba(101,215,177,.45); }

  .radio-orbit { position:relative; min-height:560px; display:grid; place-items:center; perspective:1200px; }
  .ambient-grid { position:absolute; inset:5% -4% 2%; border-radius:42px; opacity:.42; background:linear-gradient(rgba(133,161,193,.055) 1px,transparent 1px),linear-gradient(90deg,rgba(133,161,193,.055) 1px,transparent 1px); background-size:32px 32px; mask-image:radial-gradient(ellipse at center,#000 26%,transparent 75%); }
  .signal-ring { position:absolute; border:1px solid rgba(113,178,255,.11); border-radius:50%; pointer-events:none; }
  .ring-one { width:470px; height:470px; }
  .ring-two { width:555px; height:555px; border-color:rgba(145,133,255,.085); }
  .modern-console { position:relative; z-index:2; width:min(100%,570px); padding:15px; overflow:hidden; border:1px solid rgba(186,210,237,.13); border-radius:30px; background:radial-gradient(circle at 12% 3%,rgba(101,215,177,.09),transparent 28%),radial-gradient(circle at 92% 10%,rgba(145,133,255,.15),transparent 32%),linear-gradient(145deg,rgba(36,53,76,.92),rgba(18,31,49,.96)); box-shadow:0 38px 95px rgba(4,10,20,.38),0 0 90px rgba(78,168,255,.055),inset 0 1px 0 rgba(255,255,255,.07); backdrop-filter:blur(24px) saturate(1.12); transform:rotateY(-3deg) rotateX(1deg); transition:transform .45s cubic-bezier(.2,.75,.2,1),box-shadow .45s ease; }
  .modern-console::before { content:""; position:absolute; inset:0; pointer-events:none; background:linear-gradient(118deg,transparent 24%,rgba(255,255,255,.045) 43%,transparent 57%); transform:translateX(-80%); }
  .console-head,.console-foot { position:relative; z-index:2; display:flex; align-items:center; justify-content:space-between; gap:12px; }
  .console-head { padding:4px 5px 15px; }
  .console-brand { display:flex; align-items:center; gap:10px; }
  .brand-dot { width:10px; height:10px; border-radius:50%; background:var(--accent); box-shadow:0 0 0 5px rgba(78,168,255,.075),0 0 22px rgba(78,168,255,.35); }
  .console-brand div { display:grid; gap:1px; }
  .console-brand small { color:#6f8aa8; font:800 .56rem "SFMono-Regular",Consolas,monospace; letter-spacing:.18em; }
  .console-brand strong { color:#d8e5f3; font:900 .68rem "SFMono-Regular",Consolas,monospace; letter-spacing:.12em; }
  .rx-pill { display:inline-flex; align-items:center; gap:7px; padding:7px 10px; border:1px solid rgba(101,215,177,.16); border-radius:999px; background:rgba(101,215,177,.06); color:#8ce8c9; font:900 .59rem "SFMono-Regular",Consolas,monospace; }
  .rx-pill i,.console-foot i,.float-chip i { width:6px; height:6px; border-radius:50%; background:var(--rx); box-shadow:0 0 12px rgba(101,215,177,.65); }

  .coverage-display { position:relative; z-index:2; display:grid; grid-template-columns:1.2fr .8fr; gap:12px; }
  .coverage-ring { min-height:285px; display:grid; place-content:center; text-align:center; border:1px solid rgba(185,207,232,.09); border-radius:24px; background:radial-gradient(circle at center,rgba(78,168,255,.13),transparent 54%),conic-gradient(from 215deg,rgba(78,168,255,.08),rgba(145,133,255,.12),rgba(101,215,177,.13),rgba(78,168,255,.08)); box-shadow:inset 0 0 60px rgba(3,12,24,.22); }
  .coverage-ring span { color:#8298b0; font:850 .58rem "SFMono-Regular",Consolas,monospace; letter-spacing:.15em; }
  .coverage-ring strong { margin:8px 0 0; color:#f4f8fd; font:850 clamp(4.2rem,8vw,6rem) "SFMono-Regular",Consolas,monospace; letter-spacing:-.1em; text-shadow:0 0 35px rgba(78,168,255,.16); }
  .coverage-ring strong small { color:#7fa5ce; font-size:1.25rem; letter-spacing:-.05em; }
  .coverage-ring b { color:#78e1bd; font:900 .65rem "SFMono-Regular",Consolas,monospace; letter-spacing:.18em; }
  .coverage-stats { display:grid; gap:12px; }
  .coverage-stats>div { display:grid; align-content:center; padding:15px; border:1px solid rgba(185,207,232,.085); border-radius:18px; background:rgba(12,24,40,.48); }
  .coverage-stats small { color:#718aa6; font:850 .52rem "SFMono-Regular",Consolas,monospace; letter-spacing:.1em; }
  .coverage-stats strong { margin:4px 0; color:#b6adff; font:850 1.55rem "SFMono-Regular",Consolas,monospace; }
  .coverage-stats span { color:#8298b0; font-size:.61rem; }
  .spectrum-card { position:relative; z-index:2; height:132px; margin-top:12px; padding:13px 14px 11px; overflow:hidden; border:1px solid rgba(185,207,232,.085); border-radius:20px; background:linear-gradient(rgba(133,160,191,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(133,160,191,.04) 1px,transparent 1px),rgba(10,22,38,.55); background-size:100% 25%,10% 100%,auto; }
  .spectrum-head { position:relative; z-index:3; display:flex; justify-content:space-between; color:#6f88a4; font:850 .53rem "SFMono-Regular",Consolas,monospace; letter-spacing:.13em; }
  .spectrum-head b { color:#78dfbd; font-size:.52rem; }
  .spectrum-bars { position:absolute; z-index:1; left:14px; right:14px; bottom:13px; height:80px; display:flex; align-items:end; gap:3px; }
  .spectrum-bars i { flex:1; min-width:2px; height:var(--bar); border-radius:999px 999px 2px 2px; background:linear-gradient(180deg,#69bcff,#7d9cff 50%,#a184ff); opacity:.78; transform-origin:bottom; }
  .spectrum-line { position:absolute; z-index:2; left:-22%; top:31px; width:18%; height:90px; background:linear-gradient(90deg,transparent,rgba(101,215,177,.20),rgba(78,168,255,.12),transparent); filter:blur(2px); }
  .console-foot { margin-top:12px; padding:10px 6px 2px; color:#647e9a; font:800 .52rem "SFMono-Regular",Consolas,monospace; letter-spacing:.1em; }
  .console-foot span:first-child { display:inline-flex; align-items:center; gap:6px; }
  .float-chip { position:absolute; z-index:4; display:inline-flex; align-items:center; gap:7px; padding:9px 11px; border:1px solid rgba(186,209,235,.12); border-radius:999px; background:rgba(24,39,59,.86); color:#91aac5; box-shadow:0 12px 32px rgba(4,10,20,.23); backdrop-filter:blur(14px); font:850 .55rem "SFMono-Regular",Consolas,monospace; }
  .chip-left { left:-7px; top:29%; }
  .chip-right { right:-12px; bottom:17%; color:#c0b9ff; }

  .coverage-strip { display:grid; grid-template-columns:repeat(4,1fr); border-block:1px solid rgba(244,247,251,.14); }
  .coverage-strip>div { padding:25px 22px; border-right:1px solid rgba(244,247,251,.14); }
  .coverage-strip>div:last-child { border-right:0; }
  .coverage-strip small { display:block; color:#96aac1; font:850 .64rem "SFMono-Regular",Consolas,monospace; letter-spacing:.1em; }
  .coverage-strip b { display:block; margin:14px 0 4px; font-size:2rem; letter-spacing:-.05em; }
  .coverage-strip span { color:#9eb2c9; font-size:.8rem; }
  .coverage-strip .status b { color:var(--rx); }

  .packs { padding-block:108px 92px; }
  .section-head { display:grid; grid-template-columns:1fr .7fr; gap:30px; align-items:end; margin-bottom:38px; }
  .section-head>span { grid-column:1/-1; }
  .section-head h2 { margin:0; font-size:clamp(2.7rem,5.4vw,5.2rem); line-height:.94; letter-spacing:-.06em; }
  .section-head p { margin:0; color:var(--muted); line-height:1.7; }
  .pack-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:12px; }
  .pack { min-height:245px; display:grid; align-content:start; gap:13px; padding:24px; border:1px solid rgba(244,247,251,.12); border-radius:18px; background:linear-gradient(145deg,rgba(43,61,86,.82),rgba(28,43,64,.86)); transition:transform .2s ease,border-color .2s ease,background .2s ease; }
  .pack:hover { transform:translateY(-3px); border-color:rgba(78,168,255,.28); background:linear-gradient(145deg,rgba(47,67,94,.92),rgba(31,47,69,.92)); }
  .pack-top,.pack-bottom { display:flex; align-items:center; justify-content:space-between; gap:14px; }
  .bank { color:var(--accent); font:900 1rem "SFMono-Regular",Consolas,monospace; }
  .pack small { color:#9eb1c7; font:800 .62rem "SFMono-Regular",Consolas,monospace; letter-spacing:.08em; }
  .pack h3 { font-size:clamp(1.55rem,3vw,2.25rem); letter-spacing:-.04em; }
  .pack p { color:var(--muted); font-size:.84rem; line-height:1.55; }
  .pack-bottom { margin-top:auto; padding-top:10px; }
  .pack-bottom strong { font-size:1.7rem; }
  .pack-bottom i { color:var(--signal); font-size:1.45rem; font-style:normal; }

  .principles { display:grid; grid-template-columns:repeat(3,1fr); gap:14px; padding-bottom:110px; }
  .principles article { min-height:230px; padding:25px; border:1px solid rgba(244,247,251,.12); border-radius:16px; background:var(--card); }
  .principles article>span { color:var(--accent2); font:900 .7rem "SFMono-Regular",Consolas,monospace; }
  .principles h3 { margin:48px 0 10px; font-size:1.35rem; }
  .principles p { margin:0; color:var(--muted); line-height:1.65; }
  .cta { display:flex; align-items:end; justify-content:space-between; gap:40px; margin-bottom:80px; padding:42px; border:1px solid rgba(244,247,251,.13); border-radius:22px; background:linear-gradient(120deg,#223249,#1d2c41); }
  .cta small { color:var(--rx); font-size:.62rem; font-weight:900; letter-spacing:.17em; }
  .cta h2 { margin-top:17px; font-size:clamp(2.1rem,4.5vw,4rem); line-height:.95; letter-spacing:-.055em; }
  .cta>a { flex:0 0 auto; padding:14px 18px; border-radius:10px; color:#182538; background:var(--signal); font-size:.76rem; font-weight:900; }
  .cta>a span { margin-left:22px; }

  @media (hover:hover) and (prefers-reduced-motion:no-preference) {
    .modern-console { animation:console-float 6.8s ease-in-out infinite; }
    .modern-console:hover { transform:rotateY(0) rotateX(0) translateY(-5px) scale(1.012); }
    .modern-console:hover::before { animation:console-sheen 2.2s ease-out 1; }
    .spectrum-bars i { animation:spectrum-live 1.5s ease-in-out infinite alternate; animation-delay:var(--delay); }
    .spectrum-line { animation:spectrum-scan 4.2s linear infinite; }
    .rx-pill i,.console-foot i,.float-chip i,.status-line i { animation:status-pulse 1.9s ease-in-out infinite; }
    .ring-one { animation:ring-pulse 5.5s ease-in-out infinite; }
    .ring-two { animation:ring-pulse 5.5s 1.3s ease-in-out infinite; }
  }
  @keyframes console-float { 0%,100%{translate:0 0}50%{translate:0 -7px} }
  @keyframes console-sheen { 0%{transform:translateX(-80%)}100%{transform:translateX(115%)} }
  @keyframes spectrum-live { 0%{transform:scaleY(.72);opacity:.55}100%{transform:scaleY(1.09);opacity:.92} }
  @keyframes spectrum-scan { 0%{left:-22%}100%{left:112%} }
  @keyframes status-pulse { 0%,100%{opacity:.62}50%{opacity:1;box-shadow:0 0 14px rgba(101,215,177,.72)} }
  @keyframes ring-pulse { 0%,100%{opacity:.45;transform:scale(.98)}50%{opacity:.82;transform:scale(1.025)} }

  @media (max-width:900px) {
    .hero { grid-template-columns:1fr; min-height:auto; }
    .radio-orbit { min-height:590px; }
    .modern-console { transform:none; }
    .coverage-strip { grid-template-columns:1fr 1fr; }
    .coverage-strip>div:nth-child(2) { border-right:0; }
    .section-head { grid-template-columns:1fr; }
    .section-head>span { grid-column:auto; }
    .principles { grid-template-columns:1fr; }
  }
  @media (max-width:620px) {
    .hero { padding-top:54px; }
    .hero h1 { font-size:clamp(3.5rem,17vw,5.2rem); }
    .radio-orbit { min-height:600px; }
    .modern-console { padding:11px; border-radius:24px; }
    .coverage-display { grid-template-columns:1fr; }
    .coverage-ring { min-height:235px; }
    .coverage-stats { grid-template-columns:repeat(3,1fr); }
    .coverage-stats>div { padding:10px; }
    .coverage-stats strong { font-size:1rem; }
    .coverage-stats span { display:none; }
    .float-chip { display:none; }
    .ring-one { width:390px; height:390px; }
    .ring-two { width:480px; height:480px; }
    .coverage-strip { grid-template-columns:1fr; }
    .coverage-strip>div { border-right:0; border-bottom:1px solid rgba(244,247,251,.14); }
    .pack-grid { grid-template-columns:1fr; }
    .cta { align-items:flex-start; flex-direction:column; padding:28px; }
  }
  @media (prefers-reduced-motion:reduce) {
    .modern-console,.modern-console::before,.spectrum-bars i,.spectrum-line,.rx-pill i,.console-foot i,.float-chip,.signal-ring { animation:none!important; transition:none!important; }
  }
</style>
