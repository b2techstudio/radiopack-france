---
const currentPath = Astro.url.pathname;
const links = [
  ["/", "Accueil"],
  ["/regions", "Régions"],
  ["/generateur", "Générateur"],
  ["/telechargements", "Téléchargements"],
  ["/documentation", "Documentation"],
  ["/a-propos", "À propos"],
];

const isActive = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);
---
<header class="site-header">
  <div class="container nav-shell">
    <a class="brand" href="/" aria-label="RadioPack France — Accueil">
      <img src="/brand/radiopack-logo.svg" alt="Logo RadioPack France" />
      <span>
        <strong>RadioPack</strong>
        <small>France · B2Tech Studio</small>
      </span>
    </a>

    <nav class="desktop-nav" aria-label="Navigation principale">
      {
        links.map(([href, label]) => (
          <a
            class:list={[isActive(href) && "active"]}
            href={href}
            aria-current={isActive(href) ? "page" : undefined}
          >
            {label}
          </a>
        ))
      }
    </nav>

    <details class="mobile-menu">
      <summary aria-label="Ouvrir le menu de navigation">Menu</summary>
      <nav aria-label="Navigation mobile">
        {
          links.map(([href, label]) => (
            <a
              class:list={[isActive(href) && "active"]}
              href={href}
              aria-current={isActive(href) ? "page" : undefined}
            >
              {label}
            </a>
          ))
        }
        <a href="/versions">État des packs</a>
      </nav>
    </details>

    <a class="header-cta" href="/generateur">Générateur</a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    z-index: 20;
    top: 0;
    padding: 10px 0;
    background: rgba(24, 37, 56, .94);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(244, 247, 251, .11);
  }

  .site-header::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;
    height: 1px;
    pointer-events: none;
    background: linear-gradient(90deg, transparent 0%, rgba(78,168,255,.52) 30%, rgba(145,133,255,.42) 66%, transparent 100%);
    opacity: .7;
  }

  .nav-shell { display: flex; align-items: center; gap: 24px; min-height: 62px; }

  .brand { display: flex; align-items: center; gap: 12px; margin-right: auto; }
  .brand img {
    width: 54px;
    height: 54px;
    object-fit: contain;
    filter: drop-shadow(0 0 12px rgba(78,168,255,.16));
    transition: transform .22s ease, filter .22s ease;
  }
  .brand:hover img {
    transform: translateY(-1px) scale(1.035);
    filter: drop-shadow(0 0 18px rgba(78,168,255,.26));
  }
  .brand span { display: grid; line-height: 1.05; }

  .brand strong {
    color: #f4f7fb;
    font-family: "Space Grotesk", sans-serif;
    font-size: 1.04rem;
    letter-spacing: -.025em;
  }

  .brand small { margin-top: 5px; color: #9baec4; font-size: .67rem; font-weight: 800; letter-spacing: .04em; }
  .desktop-nav { display: flex; align-items: center; gap: 3px; }

  nav a {
    padding: .62rem .72rem;
    border-radius: 9px;
    color: #a9bad0;
    font-size: .78rem;
    font-weight: 800;
    transition: color .18s ease, background .18s ease;
  }

  nav a:hover,
  nav a.active { color: #f4f7fb; background: rgba(78, 168, 255, .10); }
  nav a.active { box-shadow: inset 0 0 0 1px rgba(78,168,255,.16); }

  .header-cta {
    padding: .72rem .98rem;
    border: 1px solid rgba(244,247,251,.17);
    border-radius: 10px;
    color: #182538;
    font-size: .76rem;
    font-weight: 900;
    background: #f4c95d;
    box-shadow: 0 8px 24px rgba(10,19,32,.12);
  }

  .mobile-menu { display: none; position: relative; }

  .mobile-menu summary {
    padding: .66rem .8rem;
    border: 1px solid rgba(244,247,251,.17);
    border-radius: 10px;
    color: #e5edf6;
    background: #223249;
    cursor: pointer;
    font-size: .78rem;
    font-weight: 900;
    list-style: none;
  }

  .mobile-menu summary::-webkit-details-marker { display: none; }

  .mobile-menu nav {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    display: grid;
    min-width: 230px;
    padding: 10px;
    border: 1px solid rgba(244,247,251,.14);
    border-radius: 16px;
    background: rgba(30, 45, 66, .98);
    box-shadow: 0 22px 55px rgba(9, 18, 31, .34);
  }

  @media (max-width: 940px) {
    .desktop-nav { display: none; }
    .mobile-menu { display: block; }
  }

  @media (max-width: 620px) {
    .nav-shell { gap: 9px; }
    .brand small { display: none; }
    .brand img { width: 46px; height: 46px; }
    .header-cta { padding-inline: .78rem; font-size: 0; }
    .header-cta::after { content: "CSV"; font-size: .75rem; }
  }
</style>
